<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="local-cache" value="C:\Users\conta\.nuget\packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local-cache">
      <package pattern="*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="AWSSDK.*" />
      <package pattern="Velopack" />
      <package pattern="NuGet.Versioning" />
      <package pattern="Microsoft.*" />
      <package pattern="CommunityToolkit.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
