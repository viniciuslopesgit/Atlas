#!/usr/bin/env bash
# Every push (including to dev) only goes ahead if build + tests pass in an isolated environment.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"

# Pushes that only delete refs don't need tests.
needs_tests=0
while read -r _ local_sha _ _; do
  [[ "$local_sha" =~ ^0+$ ]] || needs_tests=1
done
(( needs_tests )) || exit 0

echo "▸ pre-push: running isolated tests…"
"$ROOT/Atlas/scripts/test-isolated.sh" --smoke
