<Window x:Class="Atlas.Views.CreateStackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        Background="{DynamicResource SurfaceBrush}"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="0">
        <StackPanel>

            <!-- Drag handle / header -->
            <Border x:Name="DragHandle" Padding="24,20,20,16"
                    MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                    Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="10" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource AccentColor}" Opacity="0.15"/>
                            </Border.Background>
                            <Path Style="{StaticResource Icon}" Width="16" Height="16"
                                  Data="{StaticResource Icon.Layers}"
                                  Stroke="{DynamicResource AccentBrush}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Create New Stack" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Discover AWS resources and import them into Terraform"
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Click="Cancel_Click"
                            Style="{StaticResource GhostButton}"
                            Padding="8" VerticalAlignment="Top">
                        <TextBlock Text="✕" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Divider -->
            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="24,0,24,20"/>

            <!-- Form -->
            <StackPanel Margin="24,0,24,0">

                <TextBlock Text="Stack name" FontSize="12" FontWeight="Medium"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <Border Style="{StaticResource InputBorder}" Height="36" Margin="0,0,0,16">
                    <TextBox x:Name="TxtStackName" Style="{x:Null}"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="13" Padding="11,0"
                             VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                             CaretBrush="{DynamicResource AccentBrush}"/>
                </Border>

                <TextBlock Text="Destination folder" FontSize="12" FontWeight="Medium"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <Border Style="{StaticResource InputBorder}" Height="36" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PathText"
                                   Grid.Column="0"
                                   Text="No folder selected"
                                   FontSize="12" FontFamily="Consolas"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" Padding="11,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1" Click="BrowseFolder_Click"
                                Margin="0,4,4,4" Padding="10,0" Height="28"
                                Style="{StaticResource GhostButton}" FontSize="12">
                            <TextBlock Text="Browse" Foreground="{DynamicResource AccentBrush}"/>
                        </Button>
                    </Grid>
                </Border>
                <TextBlock Text="All imported .tf files will be written to this folder."
                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="2,0,0,0"/>

                <!-- Feedback -->
                <Border x:Name="Feedback" Margin="0,12,0,0" CornerRadius="8" Padding="12,9"
                        Visibility="Collapsed">
                    <TextBlock x:Name="FeedbackText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerBrush}"/>
                </Border>
            </StackPanel>

            <!-- Divider -->
            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,20,0,0"/>

            <!-- Footer -->
            <Grid Margin="20,14,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Style="{StaticResource GhostButton}"
                        Click="Cancel_Click"
                        Padding="16,8" Margin="0,0,8,0">
                    <TextBlock Text="Cancel" FontSize="13"/>
                </Button>

                <Button x:Name="BtnCreate" Grid.Column="2"
                        Click="Create_Click"
                        Padding="16,8"
                        Background="{DynamicResource AccentBrush}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="White" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="Create &amp; Import" FontSize="13" FontWeight="Medium" Foreground="White"/>
                    </StackPanel>
                </Button>
            </Grid>

        </StackPanel>
    </Border>
</Window>
