<Window x:Class="Atlas.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        Background="{DynamicResource SurfaceBrush}"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="0">

        <StackPanel>

            <!-- Header -->
            <Border x:Name="DragHandle" Padding="24,20,20,0"
                    MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                    Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="IconBorder" Width="34" Height="34" CornerRadius="10"
                                Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock x:Name="IconText" Text="📁" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1" Click="Cancel_Click"
                            Style="{StaticResource GhostButton}"
                            Padding="8" VerticalAlignment="Top">
                        <TextBlock Text="✕" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Message -->
            <TextBlock x:Name="MessageText" Margin="24,14,24,0"
                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" LineHeight="20"/>

            <!-- Input field -->
            <Border Style="{StaticResource InputBorder}" Margin="24,12,24,0" Height="36">
                <TextBox x:Name="InputBox" Style="{x:Null}"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="13" Padding="11,0"
                         VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                         CaretBrush="{DynamicResource AccentBrush}"
                         KeyDown="InputBox_KeyDown"/>
            </Border>

            <!-- Divider -->
            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,20,0,0"/>

            <!-- Footer -->
            <Grid Margin="20,14,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <UIElement Grid.Column="0"/>

                <Button x:Name="CancelButton" Grid.Column="1"
                        Style="{StaticResource GhostButton}"
                        Click="Cancel_Click"
                        Padding="16,8" Margin="0,0,8,0">
                    <TextBlock Text="Cancel" FontSize="13"/>
                </Button>

                <Button x:Name="ConfirmButton" Grid.Column="2"
                        Click="Confirm_Click"
                        Padding="16,8">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock x:Name="ConfirmText" FontSize="13" FontWeight="Medium" Foreground="White"/>
                </Button>
            </Grid>

        </StackPanel>
    </Border>
</Window>
