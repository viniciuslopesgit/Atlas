<UserControl x:Class="Atlas.Views.GuardDutyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Atlas.ViewModels"
             xmlns:models="clr-namespace:Atlas.Models">

    <UserControl.Resources>

        <!-- Filter chip button -->
        <Style x:Key="FilterChip" TargetType="Button">
            <Setter Property="Height"          Value="30"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="Margin"          Value="0,0,6,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SidebarActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">

        <!-- ═══════════════ NO ACCOUNT ══════════════════════════════════════ -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding HasActiveAccount, Converter={StaticResource BoolToInvisible}}">
            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="52"
                       HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
            <TextBlock Text="No AWS account configured" FontSize="16"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,12,0,0"/>
            <TextBlock Text="Go to Settings to add your first account."
                       FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- ═══════════════ MAIN CONTENT ════════════════════════════════════ -->
        <Grid Visibility="{Binding HasActiveAccount, Converter={StaticResource BoolToVisible}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Page header ────────────────────────────────────────────── -->
            <Grid Grid.Row="0" Margin="32,28,32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="GuardDuty" FontSize="24" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Threat detection findings" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Refresh button -->
                <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                        Command="{Binding RefreshCommand}"
                        Padding="10,8" VerticalAlignment="Center">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Button>
            </Grid>

            <!-- ── Body ──────────────────────────────────────────────────── -->
            <Grid Grid.Row="1" Margin="0,20,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Loading overlay -->
                <Border Grid.RowSpan="3" Background="{DynamicResource BackgroundBrush}"
                        Opacity="0.85" Panel.ZIndex="10"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisible}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="32" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Fetching GuardDuty findings…" FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Error banner -->
                <Border Grid.Row="0" Style="{StaticResource Card}"
                        Background="#33EF5350" BorderBrush="#55EF5350"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}"
                        Margin="32,0,32,12">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource DangerBrush}" FontSize="13"/>
                </Border>

                <!-- ── KPI cards ──────────────────────────────────────────── -->
                <UniformGrid Grid.Row="1" Columns="4" Rows="1" Margin="32,0,32,16">

                    <!-- Total -->
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Total Findings" FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TotalCount}" FontSize="26" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- High -->
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" CornerRadius="4"
                                        Background="{DynamicResource DangerBrush}"
                                        VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="High" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding HighCount}" FontSize="26" FontWeight="SemiBold"
                                       Foreground="{DynamicResource DangerBrush}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Medium -->
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" CornerRadius="4"
                                        Background="{DynamicResource WarningBrush}"
                                        VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Medium" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding MediumCount}" FontSize="26" FontWeight="SemiBold"
                                       Foreground="{DynamicResource WarningBrush}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Low -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" CornerRadius="4"
                                        Background="{DynamicResource SuccessBrush}"
                                        VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Low" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding LowCount}" FontSize="26" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessBrush}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                </UniformGrid>

                <!-- ── Findings table ────────────────────────────────────── -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="32,0,32,32">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Card header + search + filter chips -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Title row -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Active Findings" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Unarchived GuardDuty findings in this region"
                                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                                <!-- Search box -->
                                <Border Grid.Column="1"
                                        Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="10,0" Height="34" MinWidth="200">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE721;"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <TextBox Text="{Binding FilterText, Mode=TwoWay,
                                                             UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="13" Background="Transparent"
                                                     BorderThickness="0" Padding="0"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="Search findings…" FontSize="13"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       IsHitTestVisible="False" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FilterText}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Severity filter chips -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Command="{Binding SetSeverityFilterCommand}"
                                        CommandParameter="All" Content="All">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource FilterChip}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SeverityFilter}" Value="All">
                                                    <Setter Property="Background"  Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Foreground"  Value="White"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Command="{Binding SetSeverityFilterCommand}"
                                        CommandParameter="HIGH" Content="High">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource FilterChip}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SeverityFilter}" Value="HIGH">
                                                    <Setter Property="Background"  Value="#CCEF4444"/>
                                                    <Setter Property="Foreground"  Value="White"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Command="{Binding SetSeverityFilterCommand}"
                                        CommandParameter="MEDIUM" Content="Medium">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource FilterChip}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SeverityFilter}" Value="MEDIUM">
                                                    <Setter Property="Background"  Value="#CCFF922B"/>
                                                    <Setter Property="Foreground"  Value="White"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Command="{Binding SetSeverityFilterCommand}"
                                        CommandParameter="LOW" Content="Low">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource FilterChip}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SeverityFilter}" Value="LOW">
                                                    <Setter Property="Background"  Value="#CC51CF66"/>
                                                    <Setter Property="Foreground"  Value="White"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Column headers -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="TITLE"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="2" Text="SEVERITY"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="3" Text="TYPE"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="4" Text="RESOURCE"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="5" Text="UPDATED"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Finding rows -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <!-- Empty state -->
                                <StackPanel HorizontalAlignment="Center" Margin="0,48"
                                            Visibility="{Binding HasFindings, Converter={StaticResource BoolToInvisible}}">
                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="No findings found" FontSize="14"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                    <TextBlock Text="GuardDuty is not detecting any active threats in this region."
                                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Findings}"
                                              Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisible}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:GuardDutyFindingModel}">
                                            <Border x:Name="Row"
                                                    BorderThickness="0,0,0,1"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    Padding="0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="200"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="140"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Severity indicator dot -->
                                                    <Ellipse Grid.Column="0" Width="8" Height="8"
                                                             VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsHigh}" Value="True">
                                                                        <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsMedium}" Value="True">
                                                                        <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>

                                                    <!-- Title + description -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                                Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="13" FontWeight="Medium"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Title}"/>
                                                        <TextBlock Text="{Binding Description}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Description}"
                                                                   Margin="0,2,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Description}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!-- Severity pill -->
                                                    <Border Grid.Column="2" CornerRadius="5" Padding="8,3"
                                                            VerticalAlignment="Center" HorizontalAlignment="Left">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#2251CF66"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsHigh}" Value="True">
                                                                        <Setter Property="Background" Value="#33EF4444"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsMedium}" Value="True">
                                                                        <Setter Property="Background" Value="#33FF922B"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding SeverityLabel}" FontSize="11"
                                                                   FontWeight="Medium" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsHigh}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsMedium}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <!-- Finding type -->
                                                    <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                                               Text="{Binding Type}"
                                                               FontSize="11" FontFamily="Consolas"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Type}"
                                                               Margin="0,0,12,0"/>

                                                    <!-- Resource type -->
                                                    <TextBlock Grid.Column="4" VerticalAlignment="Center"
                                                               Text="{Binding ResourceType}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>

                                                    <!-- Updated timestamp -->
                                                    <TextBlock Grid.Column="5"
                                                               Text="{Binding UpdatedAt,
                                                                      StringFormat='yyyy-MM-dd HH:mm'}"
                                                               FontSize="11" FontFamily="Consolas"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsHigh}" Value="True">
                                                    <Setter TargetName="Row" Property="Background"
                                                            Value="#0AEF4444"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>

                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Grid>
</UserControl>
