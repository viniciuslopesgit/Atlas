<UserControl x:Class="Atlas.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Atlas.ViewModels">

    <Grid Background="{DynamicResource BackgroundBrush}">

        <!-- ═══════════════ NO ACCOUNT STATE ═══════════════════════════════ -->
        <Grid Visibility="{Binding HasActiveAccount, Converter={StaticResource BoolToInvisible}}">

            <!-- ── First-run onboarding (no accounts configured at all) ──── -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400"
                        Visibility="{Binding IsFirstRun, Converter={StaticResource BoolToVisible}}">
                <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets"
                           FontSize="56" HorizontalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="Welcome to Atlas!" FontSize="26" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,16,0,0"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Connect your AWS account to explore and manage your cloud infrastructure."
                           FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,32"
                           TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding OpenAddAccountDialogCommand}"
                        HorizontalAlignment="Center" Padding="28,11">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Add AWS Account" FontSize="14" FontWeight="Medium"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ── Accounts exist but none is active (e.g. switching accounts) ── -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsFirstRun, Converter={StaticResource BoolToInvisible}}">
                <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets"
                           FontSize="52" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock Text="No active account" FontSize="16"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="Select an account from the top menu."
                           FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════ MAIN CONTENT ════════════════════════════════════ -->
        <Grid Visibility="{Binding HasActiveAccount, Converter={StaticResource BoolToVisible}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="24,18,24,12">
            <TextBlock Text="Dashboard" FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding LastRefreshedText}" FontSize="11"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Quick Start card (shown after first-time account setup) -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="24,0,24,4"
                Visibility="{Binding ShowNextSteps, Converter={StaticResource BoolToVisible}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Quick Start" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                    <!-- Done: account configured -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="AWS account configured" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Configure Terraform (shown until configured or skipped) -->
                    <Border Margin="0,0,0,10"
                            Visibility="{Binding ShowTerraformStep, Converter={StaticResource BoolToVisible}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button Style="{StaticResource GhostButton}" Command="{Binding ConfigureTerraformCommand}"
                                        Foreground="{DynamicResource AccentBrush}" Padding="0,2"
                                        Content="Configure Terraform / OpenTofu" FontSize="13"/>
                            </StackPanel>
                            <Button Style="{StaticResource GhostButton}" Command="{Binding SkipTerraformCommand}"
                                    HorizontalAlignment="Left" Padding="0,0"
                                    Margin="21,0,0,0" FontSize="11"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Content="Skip this step"/>
                        </StackPanel>
                    </Border>

                    <!-- Explore EC2 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding GoToEc2Command}"
                                Foreground="{DynamicResource AccentBrush}" Padding="0,2"
                                Content="Explore EC2 instances" FontSize="13"/>
                    </StackPanel>

                    <!-- Explore S3 -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding GoToS3Command}"
                                Foreground="{DynamicResource AccentBrush}" Padding="0,2"
                                Content="Explore S3 buckets" FontSize="13"/>
                    </StackPanel>
                </StackPanel>

                <!-- Dismiss -->
                <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                        Command="{Binding DismissNextStepsCommand}"
                        Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                        Padding="8" VerticalAlignment="Top"
                        Foreground="{DynamicResource TextMutedBrush}"/>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24,0,24,20">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Loading overlay -->
                    <Border Grid.RowSpan="10" Background="{DynamicResource BackgroundBrush}"
                            Opacity="0.7" Panel.ZIndex="10"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisible}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Loading…" FontSize="16"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Error -->
                    <Border Grid.Row="0" Style="{StaticResource Card}"
                            Background="#33EF5350" BorderBrush="#55EF5350"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}"
                            Margin="0,0,0,16">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource DangerBrush}" FontSize="13"/>
                    </Border>

                    <!-- ── Global Search Bar ─────────────────────────────── -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"
                                       Foreground="{DynamicResource TextMutedBrush}"/>

                            <Grid Grid.Column="1">
                                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent"
                                         FontSize="14" VerticalAlignment="Center" Padding="0"
                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Search EC2 instances, S3 buckets…"
                                           FontSize="14" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="13" Margin="0,0,8,0"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisible}}"/>
                                <Button Style="{StaticResource GhostButton}"
                                        Command="{Binding ClearSearchCommand}"
                                        Padding="6,4" FontSize="13"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        Content="&#xE8BB;"
                                        FontFamily="Segoe MDL2 Assets"
                                        Visibility="{Binding SearchPanelVisible, Converter={StaticResource BoolToVisible}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ── Search Results Panel ──────────────────────────── -->
                    <Border Grid.Row="2" Style="{StaticResource Card}"
                            Margin="0,0,0,14" Padding="0"
                            Visibility="{Binding SearchPanelVisible, Converter={StaticResource BoolToVisible}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Padding="20,14" BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource BorderBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Search results" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border Background="{DynamicResource SidebarActiveBrush}"
                                                CornerRadius="10" Padding="8,2" Margin="10,0,0,0"
                                                Visibility="{Binding HasSearchResults, Converter={StaticResource BoolToVisible}}">
                                            <TextBlock Text="{Binding SearchResults.Count}"
                                                       FontSize="11" FontWeight="Medium"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SearchQuery}"
                                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Padding="20,10"
                                    Visibility="{Binding SearchErrorMessage, Converter={StaticResource NullToCollapsed}}">
                                <TextBlock Text="{Binding SearchErrorMessage}"
                                           Foreground="{DynamicResource DangerBrush}" FontSize="12"/>
                            </Border>

                            <Border Grid.Row="1" Padding="20,28"
                                    Visibility="{Binding SearchIsEmpty, Converter={StaticResource BoolToVisible}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="No resources found" FontSize="14"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <Run Text="No results for"/>
                                        <Run Text="&quot;"/><Run Text="{Binding SearchQuery}"/><Run Text="&quot;"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <ItemsControl Grid.Row="2"
                                          ItemsSource="{Binding SearchResults}"
                                          Visibility="{Binding HasSearchResults, Converter={StaticResource BoolToVisible}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Cursor="Hand"
                                                Padding="0"
                                                FocusVisualStyle="{x:Null}"
                                                Command="{Binding DataContext.NavigateToResultCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Padding="20,12" BorderThickness="0,0,0,1"
                                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                                        Background="{TemplateBinding Background}">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SidebarActiveBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding ResourceType, Converter={StaticResource ResourceTypeToIcon}}"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="16" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding TypeLabel}" FontSize="11"
                                                                   Foreground="{DynamicResource AccentBrush}"/>
                                                        <TextBlock Text=" · " FontSize="11"
                                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                                        <TextBlock Text="{Binding Id}" FontSize="11"
                                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Border Grid.Column="2" CornerRadius="6" Padding="8,3" Margin="12,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource SidebarActiveBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="running">
                                                                    <Setter Property="Background" Value="#1A4ADE80"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="stopped">
                                                                    <Setter Property="Background" Value="#1AFBBF24"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="terminated">
                                                                    <Setter Property="Background" Value="#1AF87171"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding State}" FontSize="11" FontWeight="Medium">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding State}" Value="running">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="stopped">
                                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="terminated">
                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="active">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <TextBlock Grid.Column="3" Text="{Binding Region}"
                                                           FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- ── KPI Cards ─────────────────────────────────────── -->
                    <UniformGrid Grid.Row="3" Columns="4" Rows="1" Margin="0,0,0,14">

                        <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="EC2 Running" FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}" FontWeight="Medium"/>
                                <TextBlock Text="{Binding Summary.RunningInstances, FallbackValue='—'}"
                                           FontSize="24" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,5,0,0"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0">
                                    <Run Text="{Binding Summary.TotalInstances, FallbackValue='—'}"/>
                                    <Run Text="total instances"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="EC2 Stopped" FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}" FontWeight="Medium"/>
                                <TextBlock Text="{Binding Summary.StoppedInstances, FallbackValue='—'}"
                                           FontSize="24" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,5,0,0"/>
                                <TextBlock Text="instances stopped" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="S3 Buckets" FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}" FontWeight="Medium"/>
                                <TextBlock Text="{Binding Summary.S3BucketCount, FallbackValue='—'}"
                                           FontSize="24" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,5,0,0"/>
                                <TextBlock Text="buckets in region" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Active Alarms" FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}" FontWeight="Medium"/>
                                <TextBlock Text="{Binding Summary.ActiveAlarms, FallbackValue='—'}"
                                           FontSize="24" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DangerBrush}" Margin="0,5,0,0"/>
                                <TextBlock Text="CloudWatch alarms" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- ── Cost & Usage ───────────────────────────────────── -->
                    <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Section title -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Cost &amp; Usage" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding CostSectionSubtitle}"
                                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <!-- Trend badge -->
                                <Border Grid.Column="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center"
                                        Visibility="{Binding Summary, Converter={StaticResource NullToCollapsed}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1A4ADE80"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CostTrendUp}" Value="True">
                                                    <Setter Property="Background" Value="#1AF87171"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding CostTrendText}" FontSize="11" FontWeight="Medium">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CostTrendUp}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>

                            <!-- Three cost figures — forecast hidden for historical months -->
                            <Grid Grid.Row="1" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Current / selected month -->
                                <Border Grid.Column="0" BorderThickness="0,0,1,0"
                                        BorderBrush="{DynamicResource BorderBrush}" Padding="0,0,24,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding CurrentMonthLabel}" FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding CurrentMonthCostText}"
                                                   FontSize="20" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,5,0,0"/>
                                        <TextBlock Text="blended spend" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Forecasted — current month only -->
                                <Border Grid.Column="1" BorderThickness="0,0,1,0"
                                        BorderBrush="{DynamicResource BorderBrush}" Padding="24,0"
                                        Visibility="{Binding ShowForecast, Converter={StaticResource BoolToVisible}}">
                                    <StackPanel>
                                        <TextBlock Text="Forecasted (EOM)" FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding ForecastedCostText}"
                                                   FontSize="20" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,5,0,0"/>
                                        <TextBlock Text="projected end-of-month" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Placeholder column when forecast hidden -->
                                <Border Grid.Column="1" Padding="24,0"
                                        Visibility="{Binding ShowForecast, Converter={StaticResource BoolToInvisible}}"/>

                                <!-- Previous month -->
                                <Border Grid.Column="2" Padding="24,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Previous month" FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding LastMonthCostText}"
                                                   FontSize="20" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                                        <TextBlock Text="month total" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Daily spend bar chart -->
                            <Grid Grid.Row="2"
                                  Visibility="{Binding DailyBars.Count, Converter={StaticResource ZeroToCollapsed}, FallbackValue=Collapsed}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Daily spend" FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontWeight="Medium" Margin="0,0,0,6"/>

                                <ItemsControl Grid.Row="1" ItemsSource="{Binding DailyBars}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ToolTip="{Binding Tooltip}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="72"/>
                                                    <RowDefinition Height="14"/>
                                                </Grid.RowDefinitions>

                                                <!-- Bar -->
                                                <Grid Grid.Row="0" VerticalAlignment="Stretch">
                                                    <Border VerticalAlignment="Bottom"
                                                            CornerRadius="2,2,0,0"
                                                            Height="{Binding Height}"
                                                            Margin="1,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                <Setter Property="Opacity" Value="0.55"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                        <Setter Property="Opacity" Value="1.0"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                </Grid>

                                                <!-- Day label -->
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding DayLabel}"
                                                           FontSize="9"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                        </Grid>
                    </Border>

                    <!-- ── Cost by Service ────────────────────────────────── -->
                    <Border Grid.Row="5" Style="{StaticResource Card}" Margin="0,0,0,14"
                            Visibility="{Binding HasServiceCosts, Converter={StaticResource BoolToVisible}}">
                        <StackPanel>
                            <!-- Title -->
                            <TextBlock Text="Cost by Service" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3"/>
                            <TextBlock Text="Top services by blended cost · sorted by spend"
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14"/>

                            <!-- Service rows -->
                            <ItemsControl ItemsSource="{Binding ServiceCostRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="46"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Service name -->
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding ServiceName}"
                                                       FontSize="12" FontWeight="Medium"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ServiceName}"/>

                                            <!-- Bar: track + proportional fill via star columns -->
                                            <Grid Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Height="8">
                                                <!-- Grey track (full width) -->
                                                <Border Background="{DynamicResource SidebarActiveBrush}" CornerRadius="4"/>
                                                <!-- Fill overlay using star-column proportions -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding FillLength}"/>
                                                        <ColumnDefinition Width="{Binding EmptyLength}"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Background="{DynamicResource AccentBrush}"
                                                            CornerRadius="4" Opacity="0.85"/>
                                                </Grid>
                                            </Grid>

                                            <!-- Amount -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding AmountText}"
                                                       FontSize="12" FontWeight="Medium"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>

                                            <!-- Percent -->
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding PercentText}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="8,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ── Security Quick Audit (Pro) ───────────────────── -->
                    <Border Grid.Row="6" Style="{StaticResource Card}" Margin="0,0,0,14">
                        <Grid>
                            <!-- Content -->
                            <StackPanel>
                                <!-- Header row -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Security Quick Audit" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <Border CornerRadius="6" Padding="8,2" Margin="10,0,0,0"
                                                    Background="{DynamicResource SidebarActiveBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="PRO" FontSize="10" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="IAM security posture · checks run on load"
                                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AuditStatusText}" FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                                   Margin="0,0,10,0"
                                                   Visibility="{Binding IsAuditLoading, Converter={StaticResource BoolToVisible}}"/>
                                        <Button Style="{StaticResource GhostButton}"
                                                Command="{Binding RunAuditCommand}"
                                                IsEnabled="{Binding IsAuditLoading, Converter={StaticResource BoolToInvisible}}"
                                                Padding="14,7" FontSize="12" FontWeight="Medium"
                                                Foreground="{DynamicResource AccentBrush}"
                                                Content="Run Audit"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Summary badges (visible after audit runs) -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                                            Visibility="{Binding HasAuditResults, Converter={StaticResource BoolToVisible}}">
                                    <Border CornerRadius="8" Padding="10,4" Margin="0,0,8,0" Background="#1AF87171">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xEA39;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding AuditResult.CriticalCount}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource DangerBrush}"/>
                                            <TextBlock Text=" Critical" FontSize="12" Foreground="{DynamicResource DangerBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border CornerRadius="8" Padding="10,4" Margin="0,0,8,0" Background="#1AFBBF24">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding AuditResult.WarningCount}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource WarningBrush}"/>
                                            <TextBlock Text=" Warning" FontSize="12" Foreground="{DynamicResource WarningBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border CornerRadius="8" Padding="10,4" Background="#1A4ADE80">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding AuditResult.OkCount}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SuccessBrush}"/>
                                            <TextBlock Text=" Passed" FontSize="12" Foreground="{DynamicResource SuccessBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Findings list -->
                                <ItemsControl ItemsSource="{Binding AuditResult.Findings}"
                                              Visibility="{Binding HasAuditResults, Converter={StaticResource BoolToVisible}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="14,10" Margin="0,0,0,6" CornerRadius="8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SidebarActiveBrush}"/>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding SeverityIcon}"
                                                               FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" CornerRadius="10" Padding="8,3" Margin="12,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding AffectedCount, Converter={StaticResource NullToCollapsed}}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#1AFBBF24"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                                        <Setter Property="Background" Value="#1AF87171"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding AffectedCount}" FontSize="11" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty state: no audit run yet -->
                                <Border Padding="0,16"
                                        Visibility="{Binding HasAuditResults, Converter={StaticResource BoolToInvisible}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="No audit data yet" FontSize="13"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                        <TextBlock Text="Click Run Audit to analyse your IAM configuration."
                                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Pro lock overlay -->
                            <Border CornerRadius="12" Panel.ZIndex="5"
                                    Background="{DynamicResource BackgroundBrush}" Opacity="0.94"
                                    Visibility="{Binding IsPro, Converter={StaticResource BoolToInvisible}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24">
                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Pro feature" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                    <TextBlock Text="Upgrade to Atlas Pro to run Security Audits."
                                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>


                    <!-- ── Account Info ───────────────────────────────────── -->
                    <Border Grid.Row="8" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Account Details" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Account ID -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                                    <TextBlock Text="Account ID" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" FontWeight="Medium"/>
                                    <TextBlock Text="{Binding AccountIdText}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"
                                               FontFamily="Consolas, Courier New"/>
                                </StackPanel>

                                <!-- Region -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,16">
                                    <TextBlock Text="Region" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" FontWeight="Medium"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="&#xE909;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding AccountRegionText}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontFamily="Consolas, Courier New"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- ARN -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                                    <TextBlock Text="Principal ARN" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" FontWeight="Medium"/>
                                    <TextBlock Text="{Binding AccountArnText}"
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,4,0,0"
                                               FontFamily="Consolas, Courier New"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                </Grid>

            </Grid>
        </ScrollViewer>
        </Grid><!-- end main content wrapper -->
    </Grid>
</UserControl>
