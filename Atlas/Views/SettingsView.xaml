<UserControl x:Class="Atlas.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Atlas.ViewModels">

    <ScrollViewer Background="{DynamicResource BackgroundBrush}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">

            <!-- ── Title ────────────────────────────────────────────── -->
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>

            <!-- ── Tab bar ────────────────────────────────────────────── -->
            <Border Background="{DynamicResource SidebarActiveBrush}"
                    CornerRadius="10" Padding="4"
                    HorizontalAlignment="Left" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">

                    <!-- General -->
                    <Button Command="{Binding SelectTabCommand}" CommandParameter="General"
                            Cursor="Hand" FocusVisualStyle="{x:Null}" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="7" Padding="16,7">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="General">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="General">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="General" FontSize="13" FontWeight="Medium" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="General">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Accounts -->
                    <Button Command="{Binding SelectTabCommand}" CommandParameter="Accounts"
                            Cursor="Hand" FocusVisualStyle="{x:Null}" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="7" Padding="16,7">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Accounts">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="Accounts">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Accounts" FontSize="13" FontWeight="Medium" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="Accounts">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════
                 TAB: GENERAL
            ══════════════════════════════════════════════════════ -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="General">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- Subscription -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,24" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Subscription" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                            <!-- Status pill -->
                            <Border Grid.Column="1" CornerRadius="12" Padding="12,5"
                                    Visibility="{Binding HasLicense, Converter={StaticResource BoolToVisible}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#152A1A"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLicenseActive}" Value="False">
                                                <Setter Property="Background" Value="#2A1515"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLicenseActive}" Value="False">
                                                        <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding LicenseStatus}" FontSize="12" FontWeight="Medium">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLicenseActive}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Details grid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="PLAN" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding LicensePlan}" FontSize="14" FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="LICENSE KEY" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding LicenseKeyMasked}" FontSize="13" FontFamily="Consolas"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="ACTIVATED" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding LicenseActivatedDisplay}" FontSize="14"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <TextBlock Text="RENEWS / EXPIRES" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding LicenseExpiryDisplay}" FontSize="14"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                            Background="{DynamicResource SidebarActiveBrush}"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding LicenseDaysRemaining, Converter={StaticResource NullToCollapsed}}">
                                        <TextBlock Text="{Binding LicenseDaysRemaining}" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                            <Button Style="{StaticResource PrimaryButton}"
                                    Command="{Binding UpgradeCommand}"
                                    Content="Upgrade to Pro"
                                    Margin="0,0,12,0"
                                    Visibility="{Binding IsFree, Converter={StaticResource BoolToVisible}}"/>
                            <Button Style="{StaticResource GhostButton}"
                                    Command="{Binding RefreshLicenseCommand}"
                                    IsEnabled="{Binding IsRefreshingLicense, Converter={StaticResource BoolInvert}}"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Visibility="{Binding HasLicense, Converter={StaticResource BoolToVisible}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="Refresh status" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="12"
                                       Text="{Binding LicenseRefreshMessage}"
                                       Visibility="{Binding LicenseRefreshMessage, Converter={StaticResource NullToCollapsed}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LicenseRefreshSuccess}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Appearance -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Dark Mode" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Switch between light and dark interface theme"
                                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                      IsChecked="{Binding IsDarkMode, Mode=TwoWay}"
                                      Cursor="Hand" FocusVisualStyle="{x:Null}">
                                <CheckBox.Template>
                                    <ControlTemplate TargetType="CheckBox">
                                        <Border x:Name="Track" Width="44" Height="24" CornerRadius="12"
                                                Background="{DynamicResource BorderBrush}">
                                            <Border x:Name="Thumb" Width="18" Height="18" CornerRadius="9"
                                                    Background="White" HorizontalAlignment="Left"
                                                    Margin="3,0,0,0" VerticalAlignment="Center">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1"
                                                                      Opacity="0.25" Color="Black"/>
                                                </Border.Effect>
                                            </Border>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Track" Property="Background"
                                                        Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </CheckBox.Template>
                            </CheckBox>
                        </Grid>

                        <!-- Divider -->
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16"/>

                        <!-- Start on Login -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Start Atlas on Login" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Launch Atlas automatically when you sign in to Windows"
                                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                      IsChecked="{Binding IsStartOnLogin, Mode=TwoWay}"
                                      Cursor="Hand" FocusVisualStyle="{x:Null}">
                                <CheckBox.Template>
                                    <ControlTemplate TargetType="CheckBox">
                                        <Border x:Name="Track" Width="44" Height="24" CornerRadius="12"
                                                Background="{DynamicResource BorderBrush}">
                                            <Border x:Name="Thumb" Width="18" Height="18" CornerRadius="9"
                                                    Background="White" HorizontalAlignment="Left"
                                                    Margin="3,0,0,0" VerticalAlignment="Center">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1"
                                                                      Opacity="0.25" Color="Black"/>
                                                </Border.Effect>
                                            </Border>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Track" Property="Background"
                                                        Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </CheckBox.Template>
                            </CheckBox>
                        </Grid>

                        <!-- Divider -->
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16"/>

                        <!-- Locale Timezone -->
                        <StackPanel>
                            <TextBlock Text="LOCALE TIMEZONE" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                            <ComboBox ItemsSource="{Binding Timezones}"
                                      SelectedItem="{Binding SelectedTimezone, Mode=TwoWay}"
                                      Height="34" FontSize="13"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ══════════════════════════════════════════════════════
                 TAB: ACCOUNTS
            ══════════════════════════════════════════════════════ -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="Accounts">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- Add Account -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Add AWS Account" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <Border CornerRadius="6" Padding="10,7" Margin="0,0,0,18"
                                Background="{DynamicResource SidebarActiveBrush}"
                                Visibility="{Binding IsFree, Converter={StaticResource BoolToVisible}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="The Free plan supports up to two AWS accounts. Upgrade to Pro to connect more."/>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Account Name" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource InputBorder}" Height="34">
                                    <TextBox x:Name="TbAccountName" Style="{x:Null}"
                                             Text="{Binding NewAccountName, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             FontSize="13" Padding="11,0"
                                             VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                             CaretBrush="{DynamicResource AccentBrush}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Default Region" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding CommonRegions}"
                                          SelectedItem="{Binding NewRegion}"
                                          Height="34" FontSize="13"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Access Key ID" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource InputBorder}" Height="34">
                                    <TextBox Style="{x:Null}"
                                             Text="{Binding NewAccessKeyId, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             FontFamily="Consolas" FontSize="13" Padding="11,0"
                                             VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                             CaretBrush="{DynamicResource AccentBrush}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="Secret Access Key" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource InputBorder}" Height="34">
                                    <PasswordBox x:Name="PbSecretKey" Style="{x:Null}"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 FontFamily="Consolas" FontSize="13" Padding="11,0"
                                                 VerticalAlignment="Stretch" VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                                        Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}"
                                        Command="{Binding AddAccountCommand}"
                                        Content="Validate &amp; Add Account"
                                        IsEnabled="{Binding IsValidating, Converter={StaticResource BoolInvert}}"/>
                                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ValidationSuccess}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ValidationSuccess}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{Binding ValidationMessage}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Configured Accounts -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Configured Accounts" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                        <ItemsControl ItemsSource="{Binding Accounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,10" Margin="0,0,0,8" CornerRadius="8"
                                            Background="{DynamicResource BackgroundBrush}"
                                            BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="0,0,12,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="4"
                                                            Background="{DynamicResource SidebarActiveBrush}"
                                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisible}}">
                                                        <TextBlock Text="Active" FontSize="10"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   FontWeight="Medium"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding AccessKeyId}" FontSize="11"
                                                           FontFamily="Consolas"
                                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding DefaultRegion}" FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource GhostButton}"
                                                        Command="{Binding DataContext.SetActiveCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="Set Active" Margin="0,0,4,0"
                                                        Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <Button Style="{StaticResource GhostButton}"
                                                        Command="{Binding DataContext.RemoveAccountCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="✕" Foreground="{DynamicResource DangerBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No accounts configured yet."
                                   FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,16,0,0"
                                   Visibility="{Binding Accounts.Count, Converter={StaticResource ZeroToVisible}}"/>
                    </StackPanel>
                </Border>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
