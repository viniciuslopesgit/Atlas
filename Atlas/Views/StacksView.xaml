<UserControl x:Class="Atlas.Views.StacksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Atlas.ViewModels"
             xmlns:models="clr-namespace:Atlas.Models"
             xmlns:helpers="clr-namespace:Atlas.Helpers">

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header ──────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="24,18,24,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Stacks" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Terraform stacks"
                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" VerticalAlignment="Center" Padding="14,7" Cursor="Hand"
                    Command="{Binding CreateNewStackCommand}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource AccentBrush}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Text="Create new stack" FontSize="12" FontWeight="Medium"
                                           Foreground="White" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- ── Toolbar: search + filter ──────────────────────────────── -->
        <Grid Grid.Row="1" Margin="24,0,24,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="148"/>
            </Grid.ColumnDefinitions>

            <!-- Search -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <TextBox x:Name="SearchBox"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="13,0,11,0" Height="34"/>
                <Viewbox Width="13" Height="13" HorizontalAlignment="Left"
                         Margin="11,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center">
                    <Canvas Width="16" Height="16">
                        <Ellipse Canvas.Left="1" Canvas.Top="1" Width="10" Height="10"
                                 Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.6"
                                 Fill="Transparent"/>
                        <Line X1="10" Y1="10" X2="15" Y2="15"
                              Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="Search stacks…" Margin="30,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Status filter -->
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding StatusOptions}"
                      SelectedItem="{Binding StatusFilter}"/>
        </Grid>

        <!-- ── Content ─────────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,8,24,24">
            <StackPanel>

                <!-- Empty state: no stacks at all -->
                <StackPanel HorizontalAlignment="Center" Margin="0,60,0,0"
                            Visibility="{Binding TotalCount, Converter={StaticResource ZeroToVisible}}">
                    <Path Style="{StaticResource Icon}" Width="40" Height="40"
                          Data="{StaticResource Icon.Layers}"
                          Stroke="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="No stacks yet" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    <TextBlock Text="Click Create new stack to discover and import your AWS resources."
                               FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- No filter results -->
                <StackPanel HorizontalAlignment="Center" Margin="0,48,0,0"
                            Visibility="{Binding HasNoFilterResults, Converter={StaticResource BoolToVisible}}">
                    <Path Style="{StaticResource Icon}" Width="28" Height="28"
                          Data="{StaticResource Icon.Search}"
                          Stroke="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="No stacks match your search or filter."
                               FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,4"/>
                    <TextBlock Text="Try a different keyword or reset the filter to All."
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- ── Stacks list ─────────────────────────────────────────── -->
                <ItemsControl ItemsSource="{Binding FilteredStacks}"
                              Visibility="{Binding TotalCount, Converter={StaticResource ZeroToCollapsed}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StackEntryViewModel}">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="0">
                                <StackPanel>

                                    <!-- Stack header row (click to expand) -->
                                    <Button Command="{Binding ToggleExpandCommand}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            Padding="0" FocusVisualStyle="{x:Null}" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent" Padding="20,14">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background"
                                                                Value="{DynamicResource SidebarActiveBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Chevron (rotates when expanded) -->
                                            <Path Grid.Column="0"
                                                  Width="11" Height="11" VerticalAlignment="Center"
                                                  Data="{StaticResource Icon.ChevronRight}"
                                                  Stroke="{DynamicResource TextMutedBrush}"
                                                  StrokeThickness="1.5" Stretch="Uniform"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value><RotateTransform Angle="0"/></Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>

                                            <!-- Name + meta -->
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <!-- Status badge -->
                                                    <Border CornerRadius="7" Padding="8,3" Margin="10,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding StatusBadgeBg, Converter={StaticResource HexToBrush}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="6" Height="6" Margin="0,0,5,0"
                                                                     VerticalAlignment="Center"
                                                                     Fill="{Binding StatusBadgeColor, Converter={StaticResource HexToBrush}}">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}"
                                                                                         Value="{x:Static models:StackStatus.Running}">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                            <TextBlock Text="{Binding StatusBadgeText}"
                                                                       FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{Binding StatusBadgeColor, Converter={StaticResource HexToBrush}}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="Created " FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding CreatedText}" FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <TextBlock Text=" · " FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding ProjectPath}" FontSize="11"
                                                               FontFamily="Consolas"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               MaxWidth="360" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Actions dropdown -->
                                            <Menu Grid.Column="2" VerticalAlignment="Center"
                                                  Margin="0,0,10,0" Background="Transparent">
                                                <MenuItem Padding="8,4" Cursor="Hand"
                                                          Background="Transparent"
                                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                                          FontSize="13" FontWeight="Medium">
                                                    <MenuItem.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Actions" FontSize="11"/>
                                                            <Path Data="M 0 0 L 4 4 L 8 0" StrokeThickness="1.5"
                                                                  Stroke="{DynamicResource TextMutedBrush}"
                                                                  Fill="Transparent" Width="8" Height="5"
                                                                  Margin="5,1,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </MenuItem.Header>
                                                    <MenuItem Header="Init"   Command="{Binding RunInitCommand}"/>
                                                    <MenuItem Header="Import" Command="{Binding RunImportCommand}"/>
                                                    <Separator/>
                                                    <MenuItem Header="Apply"  Command="{Binding RunApplyCommand}"/>
                                                    <Separator/>
                                                    <MenuItem Header="Fix Drift" Command="{Binding FixDriftCommand}"
                                                              Foreground="{DynamicResource AccentBrush}"
                                                              Visibility="{Binding ShowDriftDrifted, Converter={StaticResource BoolToVisible}}"/>
                                                    <Separator Visibility="{Binding ShowDriftDrifted, Converter={StaticResource BoolToVisible}}"/>
                                                    <MenuItem Header="Remove Stack"
                                                              Command="{Binding RemoveStackCommand}"
                                                              Foreground="{DynamicResource DangerBrush}"/>
                                                </MenuItem>
                                            </Menu>

                                        </Grid>
                                    </Button>

                                    <!-- Expanded: tabbed layout -->
                                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisible}}">

                                        <Border Height="1" Background="{DynamicResource BorderBrush}"/>

                                        <!-- ── Tab bar ──────────────────────────────────────────── -->
                                        <Border BorderThickness="0,0,0,1"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                Background="{DynamicResource SidebarActiveBrush}">
                                            <StackPanel Orientation="Horizontal" Margin="8,0">

                                                <!-- Runs tab -->
                                                <Button Command="{Binding SelectRunsTabCommand}"
                                                        Cursor="Hand" Background="Transparent"
                                                        BorderThickness="0" FocusVisualStyle="{x:Null}"
                                                        Padding="14,0" Height="38">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Background="Transparent"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Runs" FontSize="12" Margin="0,0,0,8">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding SelectedTab}" Value="runs">
                                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <!-- Run count badge -->
                                                            <Border CornerRadius="8" Padding="5,1" Margin="5,0,0,8"
                                                                    Background="{DynamicResource SidebarActiveBrush}"
                                                                    Visibility="{Binding RunCount, Converter={StaticResource ZeroToCollapsed}}">
                                                                <TextBlock Text="{Binding RunCount}" FontSize="10"
                                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <Border Height="2">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedTab}" Value="runs">
                                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Environment tab -->
                                                <Button Command="{Binding SelectEnvironmentTabCommand}"
                                                        Cursor="Hand" Background="Transparent"
                                                        BorderThickness="0" FocusVisualStyle="{x:Null}"
                                                        Padding="14,0" Height="38">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Background="Transparent"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Environment" FontSize="12" Margin="0,0,0,8">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding SelectedTab}" Value="environment">
                                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <!-- Env var count badge -->
                                                            <Border CornerRadius="8" Padding="5,1" Margin="5,0,0,8"
                                                                    Background="{DynamicResource SidebarActiveBrush}"
                                                                    Visibility="{Binding HasEnvVars, Converter={StaticResource BoolToVisible}}">
                                                                <TextBlock Text="{Binding EnvVarCount}" FontSize="10"
                                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <Border Height="2">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedTab}" Value="environment">
                                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Drift tab -->
                                                <Button Command="{Binding SelectDriftTabCommand}"
                                                        Cursor="Hand" Background="Transparent"
                                                        BorderThickness="0" FocusVisualStyle="{x:Null}"
                                                        Padding="14,0" Height="38">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Background="Transparent"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Drift" FontSize="12" Margin="0,0,0,8">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding SelectedTab}" Value="drift">
                                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <!-- Drift status badge in tab label -->
                                                            <Border CornerRadius="8" Padding="6,1" Margin="5,0,0,8"
                                                                    Visibility="{Binding ShowDriftDrifted, Converter={StaticResource BoolToVisible}}"
                                                                    Background="#1AF59E0B">
                                                                <TextBlock Text="!" FontSize="10" FontWeight="Bold"
                                                                           Foreground="#F59E0B"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <Border Height="2">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedTab}" Value="drift">
                                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                    </StackPanel>
                                                </Button>

                                            </StackPanel>
                                        </Border>

                                        <!-- ── Runs tab content ─────────────────────────────────── -->
                                        <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource EqualToVisible}, ConverterParameter=runs}">

                                            <!-- Empty state when no runs yet -->
                                            <StackPanel HorizontalAlignment="Center" Margin="0,32,0,32"
                                                        Visibility="{Binding RunCount, Converter={StaticResource ZeroToVisible}}">
                                                <TextBlock Text="No runs yet" FontSize="13" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="Use Actions → Init or Import to get started."
                                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <!-- Column headers (only when runs exist) -->
                                            <Border Padding="0,8,0,8"
                                                    Background="{DynamicResource SidebarActiveBrush}"
                                                    Visibility="{Binding RunCount, Converter={StaticResource ZeroToCollapsed}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="56"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="80"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="1" Text="Type"     FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="Date"     FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <TextBlock Grid.Column="3" Text="Duration" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                                                </Grid>
                                            </Border>

                                            <!-- Run rows -->
                                            <ItemsControl ItemsSource="{Binding Runs}"
                                                          Visibility="{Binding RunCount, Converter={StaticResource ZeroToCollapsed}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:StackRunViewModel}">
                                                        <StackPanel>

                                                            <!-- Run info row -->
                                                            <Button Command="{Binding ToggleOutputCommand}"
                                                                    HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    Padding="0" FocusVisualStyle="{x:Null}"
                                                                    Cursor="Hand">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bd" Padding="0"
                                                                                MinHeight="44"
                                                                                BorderThickness="0,0,0,1"
                                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                                Background="Transparent">
                                                                            <ContentPresenter/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background"
                                                                                        Value="{DynamicResource SidebarActiveBrush}"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="56"/>
                                                                        <ColumnDefinition Width="70"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="80"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Pipeline column -->
                                                                    <Grid Grid.Column="0" VerticalAlignment="Stretch">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="*"/>
                                                                            <RowDefinition Height="16"/>
                                                                            <RowDefinition Height="*"/>
                                                                        </Grid.RowDefinitions>

                                                                        <Rectangle Grid.Row="0" Width="2"
                                                                                   HorizontalAlignment="Center"
                                                                                   Opacity="0.1"
                                                                                   Fill="{DynamicResource TextMutedBrush}"
                                                                                   Visibility="{Binding IsFirst, Converter={StaticResource BoolToHidden}}"/>

                                                                        <Grid Grid.Row="1" Width="16" Height="16"
                                                                              HorizontalAlignment="Center" VerticalAlignment="Center">

                                                                            <Ellipse Fill="#16A34A">
                                                                                <Ellipse.Style>
                                                                                    <Style TargetType="Ellipse">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:StackRunStatus.Success}">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Ellipse.Style>
                                                                            </Ellipse>
                                                                            <Path Data="{StaticResource Icon.Check}"
                                                                                  Stroke="White" StrokeThickness="2"
                                                                                  Stretch="Uniform" Fill="Transparent"
                                                                                  Width="8" Height="8">
                                                                                <Path.Style>
                                                                                    <Style TargetType="Path">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:StackRunStatus.Success}">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Path.Style>
                                                                            </Path>

                                                                            <Path Data="{StaticResource Icon.AlertCircle}"
                                                                                  Stroke="#DC2626" StrokeThickness="1.8"
                                                                                  Stretch="Uniform" Fill="Transparent"
                                                                                  Width="16" Height="16">
                                                                                <Path.Style>
                                                                                    <Style TargetType="Path">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:StackRunStatus.Failed}">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Path.Style>
                                                                            </Path>

                                                                            <Path Data="{StaticResource Icon.LoaderCircle}"
                                                                                  Stroke="{DynamicResource AccentBrush}"
                                                                                  StrokeThickness="2" Fill="Transparent"
                                                                                  Stretch="Uniform" Width="15" Height="15">
                                                                                <Path.Style>
                                                                                    <Style TargetType="Path">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:StackRunStatus.Running}">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Path.Style>
                                                                                <Path.RenderTransform>
                                                                                    <RotateTransform x:Name="SpinTransform" CenterX="7.5" CenterY="7.5"/>
                                                                                </Path.RenderTransform>
                                                                                <Path.Triggers>
                                                                                    <EventTrigger RoutedEvent="Path.Loaded">
                                                                                        <BeginStoryboard>
                                                                                            <Storyboard RepeatBehavior="Forever">
                                                                                                <DoubleAnimation
                                                                                                    Storyboard.TargetName="SpinTransform"
                                                                                                    Storyboard.TargetProperty="Angle"
                                                                                                    From="0" To="360"
                                                                                                    Duration="0:0:1"/>
                                                                                            </Storyboard>
                                                                                        </BeginStoryboard>
                                                                                    </EventTrigger>
                                                                                </Path.Triggers>
                                                                            </Path>

                                                                            <Ellipse Stroke="{DynamicResource TextMutedBrush}"
                                                                                     StrokeThickness="1.5" Fill="Transparent">
                                                                                <Ellipse.Style>
                                                                                    <Style TargetType="Ellipse">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:StackRunStatus.Cancelled}">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Ellipse.Style>
                                                                            </Ellipse>
                                                                            <Path Data="{StaticResource Icon.Minus}"
                                                                                  Stroke="{DynamicResource TextMutedBrush}"
                                                                                  StrokeThickness="2" Fill="Transparent"
                                                                                  Stretch="Uniform" Width="7" Height="7">
                                                                                <Path.Style>
                                                                                    <Style TargetType="Path">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:StackRunStatus.Cancelled}">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Path.Style>
                                                                            </Path>

                                                                        </Grid>

                                                                        <Rectangle Grid.Row="2" Width="2"
                                                                                   HorizontalAlignment="Center"
                                                                                   Opacity="0.1"
                                                                                   Fill="{DynamicResource TextMutedBrush}"
                                                                                   Visibility="{Binding IsLast, Converter={StaticResource BoolToHidden}}"/>
                                                                    </Grid>

                                                                    <!-- Run type badge -->
                                                                    <Border Grid.Column="1" CornerRadius="5"
                                                                            Padding="8,3" VerticalAlignment="Center"
                                                                            HorizontalAlignment="Left"
                                                                            Background="{DynamicResource SidebarActiveBrush}">
                                                                        <TextBlock Text="{Binding TypeLabel}"
                                                                                   FontSize="10" FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource AccentBrush}"/>
                                                                    </Border>

                                                                    <!-- Date + trigger -->
                                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                                                Margin="0,10,0,10">
                                                                        <TextBlock Text="{Binding TriggerText}"
                                                                                   FontSize="12"
                                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                        <TextBlock Text="{Binding StartedText}"
                                                                                   FontSize="11"
                                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                                   Margin="0,1,0,0"/>
                                                                    </StackPanel>

                                                                    <!-- Duration -->
                                                                    <TextBlock Grid.Column="3"
                                                                               Text="{Binding DurationText}"
                                                                               FontSize="11" FontFamily="Consolas"
                                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                                               VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Button>

                                                            <!-- Output panel -->
                                                            <Border Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisible}}"
                                                                    Background="#0D000000"
                                                                    BorderThickness="0,0,0,1"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    Padding="20,12">
                                                                <Grid>
                                                                    <ScrollViewer MaxHeight="320"
                                                                                  VerticalScrollBarVisibility="Auto"
                                                                                  HorizontalScrollBarVisibility="Auto"
                                                                                  CanContentScroll="True"
                                                                                  helpers:ScrollBehavior.AutoScroll="True">
                                                                        <TextBox Text="{Binding Output, Mode=OneWay}"
                                                                                 IsReadOnly="True"
                                                                                 Background="Transparent"
                                                                                 BorderThickness="0"
                                                                                 FontFamily="Consolas, Courier New"
                                                                                 FontSize="11"
                                                                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                 TextWrapping="NoWrap"
                                                                                 VerticalScrollBarVisibility="Disabled"
                                                                                 HorizontalScrollBarVisibility="Disabled"
                                                                                 FocusVisualStyle="{x:Null}"
                                                                                 IsUndoEnabled="False"/>
                                                                    </ScrollViewer>
                                                                    <Button Command="{Binding CopyOutputCommand}"
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Top"
                                                                            Style="{StaticResource GhostButton}"
                                                                            Padding="7,3" Cursor="Hand"
                                                                            ToolTip="Copy logs to clipboard">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Path Data="{StaticResource Icon.Copy}"
                                                                                  Width="11" Height="11"
                                                                                  Stroke="{DynamicResource TextMutedBrush}"
                                                                                  StrokeThickness="1.5"
                                                                                  Fill="Transparent" Stretch="Uniform"
                                                                                  VerticalAlignment="Center"/>
                                                                            <TextBlock Text="Copy" FontSize="10"
                                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                                       Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Button>
                                                                </Grid>
                                                            </Border>

                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                        </StackPanel>
                                        <!-- end Runs tab -->

                                        <!-- ── Environment tab content ──────────────────────────── -->
                                        <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource EqualToVisible}, ConverterParameter=environment}">

                                            <!-- Description bar (only when vars exist) -->
                                            <Border Padding="16,9"
                                                    Background="{DynamicResource SidebarActiveBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    Visibility="{Binding HasEnvVars, Converter={StaticResource BoolToVisible}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Style="{StaticResource Icon}" Width="12" Height="12"
                                                          Data="{StaticResource Icon.Lock}"
                                                          Stroke="{DynamicResource TextMutedBrush}"
                                                          Margin="0,0,8,0"/>
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}">
                                                        <Run Text="{Binding EnvVarCount, Mode=OneWay}"/>
                                                        <Run Text=" variables extracted · values stored encrypted · injected as TF_VAR_* at runtime"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>

                                            <!-- Empty state -->
                                            <StackPanel Visibility="{Binding HasEnvVars, Converter={StaticResource BoolToInvisible}}"
                                                        HorizontalAlignment="Center" Margin="0,40,0,40">
                                                <Path Style="{StaticResource Icon}" Width="28" Height="28"
                                                      Data="{StaticResource Icon.Lock}"
                                                      Stroke="{DynamicResource TextMutedBrush}"
                                                      HorizontalAlignment="Center"/>
                                                <TextBlock Text="No environment variables"
                                                           FontSize="13" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center" Margin="0,10,0,4"/>
                                                <TextBlock Text="Run Import to extract hardcoded values from .tf files."
                                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Vars table -->
                                            <StackPanel Visibility="{Binding HasEnvVars, Converter={StaticResource BoolToVisible}}">

                                                <!-- Column headers -->
                                                <Border Padding="20,6,20,6"
                                                        Background="{DynamicResource SidebarActiveBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        BorderBrush="{DynamicResource BorderBrush}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="200"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="120"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Variable"  FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                                                        <TextBlock Grid.Column="1" Text="Value"     FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                                                        <TextBlock Grid.Column="2" Text="tf var"    FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                                                        <TextBlock Grid.Column="3" Text="Resource"  FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Var rows -->
                                                <ItemsControl ItemsSource="{Binding EnvVars}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:StackEnvVarViewModel}">
                                                            <Border Padding="20,8,20,8"
                                                                    BorderThickness="0,0,0,1"
                                                                    BorderBrush="{DynamicResource BorderBrush}">
                                                                <Grid MinHeight="28">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="200"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="120"/>
                                                                        <ColumnDefinition Width="120"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding EnvKey}"
                                                                               FontFamily="Consolas" FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                                               VerticalAlignment="Center"/>

                                                                    <Grid Grid.Column="1" Margin="0,0,8,0">

                                                                        <StackPanel Orientation="Horizontal"
                                                                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToInvisible}}">
                                                                            <TextBlock Text="{Binding DisplayValue}"
                                                                                       FontFamily="Consolas" FontSize="11"
                                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                       VerticalAlignment="Center"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       MaxWidth="260"/>
                                                                            <Button Command="{Binding ToggleVisibilityCommand}"
                                                                                    Style="{StaticResource GhostButton}"
                                                                                    Padding="6,2" Margin="6,0,0,0"
                                                                                    VerticalAlignment="Center">
                                                                                <TextBlock FontSize="10"
                                                                                           Foreground="{DynamicResource AccentBrush}">
                                                                                    <TextBlock.Style>
                                                                                        <Style TargetType="TextBlock">
                                                                                            <Setter Property="Text" Value="Show"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsValueVisible}" Value="True">
                                                                                                    <Setter Property="Text" Value="Hide"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBlock.Style>
                                                                                </TextBlock>
                                                                            </Button>
                                                                            <Button Command="{Binding StartEditCommand}"
                                                                                    Style="{StaticResource GhostButton}"
                                                                                    Padding="6,2" Margin="4,0,0,0"
                                                                                    VerticalAlignment="Center">
                                                                                <TextBlock Text="Edit" FontSize="10"
                                                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                                                            </Button>
                                                                        </StackPanel>

                                                                        <StackPanel Orientation="Horizontal"
                                                                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisible}}">
                                                                            <TextBox Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}"
                                                                                     FontFamily="Consolas" FontSize="11"
                                                                                     Width="260" Padding="6,3"
                                                                                     VerticalAlignment="Center"/>
                                                                            <Button Command="{Binding SaveEditCommand}"
                                                                                    Style="{StaticResource GhostButton}"
                                                                                    Padding="8,3" Margin="6,0,0,0"
                                                                                    VerticalAlignment="Center">
                                                                                <TextBlock Text="Save" FontSize="10"
                                                                                           Foreground="{DynamicResource AccentBrush}"/>
                                                                            </Button>
                                                                            <Button Command="{Binding CancelEditCommand}"
                                                                                    Style="{StaticResource GhostButton}"
                                                                                    Padding="8,3" Margin="2,0,0,0"
                                                                                    VerticalAlignment="Center">
                                                                                <TextBlock Text="Cancel" FontSize="10"
                                                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Grid>

                                                                    <TextBlock Grid.Column="2"
                                                                               Text="{Binding TfVarName, StringFormat='var.{0}'}"
                                                                               FontFamily="Consolas" FontSize="10"
                                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"/>

                                                                    <TextBlock Grid.Column="3"
                                                                               Text="{Binding ResourceLabel}"
                                                                               FontSize="10"
                                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                            </StackPanel>
                                        </StackPanel>
                                        <!-- end Environment tab -->

                                        <!-- ── Drift tab content ────────────────────────────────── -->
                                        <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource EqualToVisible}, ConverterParameter=drift}"
                                                    Margin="20,18,20,22">

                                            <!-- Description -->
                                            <TextBlock Text="Atlas runs terraform plan on a schedule and flags infrastructure changes not managed in code."
                                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                                       TextWrapping="Wrap" Margin="0,0,0,20"/>

                                            <!-- ── Section: Detection ────────────────────────────── -->
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="DETECTION" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <Border Grid.Column="1" Height="1"
                                                        Background="{DynamicResource BorderBrush}"
                                                        VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Interval chips -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                <TextBlock Text="Interval" FontSize="12" Width="80"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"/>

                                                <Button Command="{Binding SetDriftIntervalCommand}" CommandParameter="Off"
                                                        Cursor="Hand" Margin="0,0,6,0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" CornerRadius="6" Padding="10,5"
                                                                    Background="{DynamicResource SidebarActiveBrush}">
                                                                <TextBlock x:Name="Txt" Text="Off" FontSize="11" FontWeight="Medium"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding DriftInterval}" Value="{x:Static models:DriftInterval.Off}">
                                                                    <Setter TargetName="Bd"  Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter TargetName="Txt" Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <Button Command="{Binding SetDriftIntervalCommand}" CommandParameter="Hourly"
                                                        IsEnabled="{Binding HasCronEntries, Converter={StaticResource BoolInvert}}"
                                                        Cursor="Hand" Margin="0,0,6,0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" CornerRadius="6" Padding="10,5"
                                                                    Background="{DynamicResource SidebarActiveBrush}">
                                                                <TextBlock x:Name="Txt" Text="Hourly" FontSize="11" FontWeight="Medium"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding DriftInterval}" Value="{x:Static models:DriftInterval.Hourly}">
                                                                    <Setter TargetName="Bd"  Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter TargetName="Txt" Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <Button Command="{Binding SetDriftIntervalCommand}" CommandParameter="Daily"
                                                        IsEnabled="{Binding HasCronEntries, Converter={StaticResource BoolInvert}}"
                                                        Cursor="Hand" Margin="0,0,6,0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" CornerRadius="6" Padding="10,5"
                                                                    Background="{DynamicResource SidebarActiveBrush}">
                                                                <TextBlock x:Name="Txt" Text="Daily" FontSize="11" FontWeight="Medium"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding DriftInterval}" Value="{x:Static models:DriftInterval.Daily}">
                                                                    <Setter TargetName="Bd"  Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter TargetName="Txt" Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <Button Command="{Binding SetDriftIntervalCommand}" CommandParameter="Weekly"
                                                        IsEnabled="{Binding HasCronEntries, Converter={StaticResource BoolInvert}}"
                                                        Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" CornerRadius="6" Padding="10,5"
                                                                    Background="{DynamicResource SidebarActiveBrush}">
                                                                <TextBlock x:Name="Txt" Text="Weekly" FontSize="11" FontWeight="Medium"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding DriftInterval}" Value="{x:Static models:DriftInterval.Weekly}">
                                                                    <Setter TargetName="Bd"  Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter TargetName="Txt" Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>

                                            <!-- Auto-fix toggle -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                                <TextBlock Text="Auto-fix" FontSize="12" Width="80"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"/>
                                                <ToggleButton IsChecked="{Binding AutoFixOnDrift}"
                                                              Cursor="Hand" FocusVisualStyle="{x:Null}"
                                                              BorderThickness="0" Background="Transparent">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border x:Name="Track" Width="38" Height="22"
                                                                    CornerRadius="11"
                                                                    Background="{DynamicResource SidebarActiveBrush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1.5">
                                                                <Border x:Name="Thumb" Width="14" Height="14"
                                                                        CornerRadius="7"
                                                                        Background="{DynamicResource TextMutedBrush}"
                                                                        HorizontalAlignment="Left"
                                                                        Margin="2,0,0,0"
                                                                        VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter TargetName="Thumb" Property="Background" Value="White"/>
                                                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                                                    <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                                <TextBlock Text="Apply automatically when drift is detected"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- ── Section: Schedule ─────────────────────────────── -->
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="SCHEDULE" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <Border Grid.Column="1" Height="1"
                                                        Background="{DynamicResource BorderBrush}"
                                                        VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- CRON entries list -->
                                            <ItemsControl ItemsSource="{Binding CronEntries}" Margin="0,0,0,6">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:DriftCronEntryViewModel}">
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <Border Background="{DynamicResource SidebarActiveBrush}"
                                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                                        BorderThickness="1" CornerRadius="6"
                                                                        Padding="10,7">
                                                                    <TextBox Text="{Binding Expression, UpdateSourceTrigger=LostFocus}"
                                                                             FontFamily="Consolas" FontSize="12"
                                                                             Background="Transparent"
                                                                             BorderThickness="0"
                                                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                                                             FocusVisualStyle="{x:Null}"
                                                                             IsUndoEnabled="False"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding Description}"
                                                                           FontSize="10"
                                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                                           Margin="2,4,0,0"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1"
                                                                    Command="{Binding DeleteCommand}"
                                                                    Style="{StaticResource GhostButton}"
                                                                    Padding="8,4" Margin="8,0,0,0"
                                                                    VerticalAlignment="Top" Cursor="Hand">
                                                                <TextBlock Text="&#xE74D;"
                                                                           FontFamily="Segoe MDL2 Assets"
                                                                           FontSize="13"
                                                                           Foreground="{DynamicResource DangerBrush}"/>
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Add CRON expression input -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Background="{DynamicResource SidebarActiveBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="6">
                                                    <TextBox Text="{Binding NewCronExpression, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="180" Padding="8,5"
                                                             FontFamily="Consolas" FontSize="11"
                                                             Background="Transparent" BorderThickness="0"
                                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                                             FocusVisualStyle="{x:Null}"
                                                             IsUndoEnabled="False"
                                                             VerticalAlignment="Center"/>
                                                </Border>
                                                <Button Command="{Binding AddCronEntryCommand}"
                                                        Style="{StaticResource GhostButton}"
                                                        Padding="10,5" Margin="6,0,0,0"
                                                        Cursor="Hand" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="+" FontSize="14" FontWeight="Bold"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text=" Add CRON expression"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   Margin="3,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                            <TextBlock Text="e.g.  */15 * * * *   ·   0 9 * * 1-5   ·   0 0 1 * *"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="0,2,0,0"/>

                                            <!-- ── Section: Status ───────────────────────────────── -->
                                            <Grid Margin="0,20,0,14"
                                                  Visibility="{Binding DriftEnabled, Converter={StaticResource BoolToVisible}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="STATUS" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <Border Grid.Column="1" Height="1"
                                                        Background="{DynamicResource BorderBrush}"
                                                        VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Stats card -->
                                            <Border Visibility="{Binding DriftEnabled, Converter={StaticResource BoolToVisible}}"
                                                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                                    CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Text="Last check" FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,0,8"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding LastDriftText}"
                                                               FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,0,8"/>

                                                    <TextBlock Grid.Row="1" Text="Status" FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,0,8"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DriftBadgeText}"
                                                               FontSize="11" FontWeight="Medium"
                                                               Foreground="{Binding DriftBadgeColor, Converter={StaticResource HexToBrush}}"
                                                               VerticalAlignment="Center" Margin="0,0,0,8"/>

                                                    <TextBlock Grid.Row="2" Text="Next check" FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding NextDriftText}"
                                                               FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Healthy: matches Terraform config -->
                                            <Border Visibility="{Binding ShowDriftClean, Converter={StaticResource BoolToVisible}}"
                                                    Background="#1A4ADE80" CornerRadius="8"
                                                    Padding="14,12" Margin="0,0,0,12">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource Icon.CircleCheck}"
                                                          Width="16" Height="16"
                                                          Stroke="#4ADE80" StrokeThickness="1.5"
                                                          Fill="Transparent" Stretch="Uniform"
                                                          VerticalAlignment="Center"/>
                                                    <TextBlock Text="Infrastructure matches your Terraform configuration"
                                                               FontSize="12" Foreground="#4ADE80"
                                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Drift detected -->
                                            <StackPanel Visibility="{Binding ShowDriftDrifted, Converter={StaticResource BoolToVisible}}"
                                                        Margin="0,0,0,10">

                                                <Border Background="#0DF59E0B" CornerRadius="8"
                                                        Padding="14,12" Margin="0,0,0,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource Icon.AlertCircle}"
                                                                  Width="14" Height="14"
                                                                  Stroke="#F59E0B" StrokeThickness="1.5"
                                                                  Fill="Transparent" Stretch="Uniform"
                                                                  VerticalAlignment="Center"/>
                                                            <TextBlock Text="Drift detected" FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="#F59E0B" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding DriftSummary}"
                                                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                                                       Visibility="{Binding DriftSummary, Converter={StaticResource NullToCollapsed}}"/>
                                                        </StackPanel>
                                                        <!-- Inline actions -->
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <Button Command="{Binding IgnoreDriftCommand}"
                                                                    Style="{StaticResource GhostButton}"
                                                                    Padding="8,4" Cursor="Hand" Margin="0,0,6,0">
                                                                <TextBlock Text="Ignore" FontSize="11"
                                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                                            </Button>
                                                            <Button Command="{Binding FixDriftCommand}"
                                                                    Cursor="Hand" Padding="10,4">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bd" Background="{DynamicResource AccentBrush}"
                                                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <Path Data="{StaticResource Icon.Check}"
                                                                                      Width="10" Height="10"
                                                                                      Stroke="White" StrokeThickness="2"
                                                                                      Fill="Transparent" Stretch="Uniform"
                                                                                      VerticalAlignment="Center"/>
                                                                                <TextBlock Text="Fix Drift"
                                                                                           FontSize="11" FontWeight="Medium"
                                                                                           Foreground="White"
                                                                                           Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- Affected resources list -->
                                                <ItemsControl ItemsSource="{Binding DriftAffectedResources}"
                                                              Margin="0,0,0,10">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:DriftAffectedResource}">
                                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                <Border Width="20">
                                                                    <TextBlock Text="{Binding ActionLabel}"
                                                                               FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                                                                               Foreground="{Binding ActionColor, Converter={StaticResource HexToBrush}}"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding Address}"
                                                                           FontFamily="Consolas" FontSize="11"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Action, StringFormat=' ({0})'}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Diff viewer -->
                                                <Border Background="#0A000000" CornerRadius="6"
                                                        Margin="0,0,0,4" MaxHeight="260">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Auto">
                                                        <ItemsControl ItemsSource="{Binding DriftDiffLines}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:DriftDiffLine}">
                                                                    <Border Background="{Binding Bg, Converter={StaticResource HexToBrush}}"
                                                                            Padding="12,1">
                                                                        <TextBlock Text="{Binding Text}"
                                                                                   FontFamily="Consolas" FontSize="11"
                                                                                   Foreground="{Binding Fg, Converter={StaticResource HexToBrush}}"
                                                                                   TextWrapping="NoWrap"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Border>

                                            </StackPanel>
                                            <!-- end Drift detected -->

                                            <!-- Drift acknowledged -->
                                            <Border Visibility="{Binding ShowDriftAcknow, Converter={StaticResource BoolToVisible}}"
                                                    Background="#1A94A3B8" CornerRadius="8"
                                                    Padding="14,12" Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource Icon.Check}"
                                                              Width="14" Height="14"
                                                              Stroke="#94A3B8" StrokeThickness="1.5"
                                                              Fill="Transparent" Stretch="Uniform"
                                                              VerticalAlignment="Center"/>
                                                        <TextBlock Text="Drift acknowledged — will re-check on next scheduled run"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Command="{Binding CheckDriftNowCommand}"
                                                            Style="{StaticResource GhostButton}"
                                                            Padding="8,4" Cursor="Hand">
                                                        <TextBlock Text="Re-check now" FontSize="11"
                                                                   Foreground="{DynamicResource AccentBrush}"/>
                                                    </Button>
                                                </Grid>
                                            </Border>

                                            <!-- Check now button -->
                                            <Button Command="{Binding CheckDriftNowCommand}"
                                                    Visibility="{Binding DriftEnabled, Converter={StaticResource BoolToVisible}}"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource GhostButton}"
                                                    Padding="10,6" Cursor="Hand">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource Icon.RefreshCw}"
                                                          Width="12" Height="12"
                                                          Stroke="{DynamicResource AccentBrush}"
                                                          StrokeThickness="1.5" Fill="Transparent"
                                                          Stretch="Uniform" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Check now" FontSize="12"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                        </StackPanel>
                                        <!-- end Drift tab -->

                                    </StackPanel>
                                    <!-- end Expanded tabbed layout -->

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
