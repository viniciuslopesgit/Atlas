<UserControl x:Class="Atlas.Views.Ec2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{DynamicResource BackgroundBrush}">

        <!-- ═══════════════ NO ACCOUNT ══════════════════════════════════════ -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding HasActiveAccount, Converter={StaticResource BoolToInvisible}}">
            <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="52"
                       HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
            <TextBlock Text="No AWS account configured" FontSize="16"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,12,0,0"/>
            <TextBlock Text="Go to Settings to add your first account."
                       FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- ═══════════════ MAIN CONTENT ════════════════════════════════════ -->
        <Grid Visibility="{Binding HasActiveAccount, Converter={StaticResource BoolToVisible}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="32,28,32,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="EC2 Instances" FontSize="24" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0">
                    <Run Text="{Binding Instances.Count, Mode=OneWay}"/>
                    <Run Text="instances"/>
                </TextBlock>
            </StackPanel>

            <Button Grid.Column="1" VerticalAlignment="Center" Padding="14,7" Cursor="Hand"
                    Command="{Binding LaunchInstanceCommand}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource AccentBrush}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Text="Launch instance" FontSize="12" FontWeight="Medium"
                                           Foreground="White" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="32,0,32,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="148"/>
            </Grid.ColumnDefinitions>

            <!-- Search -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <TextBox x:Name="SearchBox"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="13,0,11,0" Height="34"/>
                <Viewbox Width="13" Height="13" HorizontalAlignment="Left"
                         Margin="11,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center">
                    <Canvas Width="16" Height="16">
                        <Ellipse Canvas.Left="1" Canvas.Top="1" Width="10" Height="10"
                                 Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.6"
                                 Fill="Transparent"/>
                        <Line X1="10" Y1="10" X2="15" Y2="15"
                              Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="Search instances…" Margin="30,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Status filter -->
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding StatusOptions}"
                      SelectedItem="{Binding StatusFilter}"/>
        </Grid>

        <!-- Error -->
        <Border Grid.Row="2" Margin="32,0,32,10" Padding="14,9" CornerRadius="8"
                Background="#22F87171" BorderBrush="#44F87171" BorderThickness="1"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="13"/>
        </Border>

        <!-- Main content: table + detail panel -->
        <Grid x:Name="ContentGrid" Grid.Row="3" Margin="32,0,32,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition x:Name="SplitterColumn" Width="0" MaxWidth="8"/>
                <ColumnDefinition x:Name="DetailColumn"   Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- GridSplitter between table and detail panel -->
            <GridSplitter x:Name="DetailSplitter"
                          Grid.Column="1"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          Cursor="SizeWE">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

        <!-- DataGrid card -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Loading overlay -->
                <Border Grid.RowSpan="2" Background="{DynamicResource SurfaceBrush}" Opacity="0.85"
                        Panel.ZIndex="5" CornerRadius="12"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Text="Loading instances…" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Table -->
                <DataGrid x:Name="InstanceGrid" Grid.Row="0"
                          ItemsSource="{Binding Instances}"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionChanged="InstanceGrid_SelectionChanged"
                          HorizontalScrollBarVisibility="Auto"
                          Margin="0">
                    <DataGrid.Columns>

                        <!-- Checkbox column -->
                        <DataGridTemplateColumn Width="46" MinWidth="46" CanUserResize="False" CanUserSort="False">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Focusable="False"
                                              IsChecked="{Binding DataContext.AreAllInstancesSelected,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid},
                                                  Mode=OneWay}"
                                              PreviewMouseLeftButtonDown="SelectAll_PreviewMouseDown"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsChecked="{Binding IsSelected,
                                                          RelativeSource={RelativeSource AncestorType=DataGridRow},
                                                          Mode=OneWay}"
                                              Focusable="False"
                                              PreviewMouseLeftButtonDown="RowCheckBox_PreviewMouseDown"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- State badge -->
                        <DataGridTemplateColumn Header="State" Width="90" MinWidth="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="5" Padding="7,3" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="running">
                                                        <Setter Property="Background" Value="#1A4ADE80"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="stopped">
                                                        <Setter Property="Background" Value="#1AF87171"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="pending">
                                                        <Setter Property="Background" Value="#1AFBBF24"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="stopping">
                                                        <Setter Property="Background" Value="#1AFBBF24"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="shutting-down">
                                                        <Setter Property="Background" Value="#1AC084FC"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="terminated">
                                                        <Setter Property="Background" Value="#1A6B7280"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="Medium">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding State}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="running">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="stopped">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="pending">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="stopping">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="shutting-down">
                                                            <Setter Property="Foreground" Value="#C084FC"/>
                                                            <Setter Property="Text" Value="shutting"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="terminated">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Name"        Binding="{Binding Name}"             Width="*"   MinWidth="140"/>
                        <DataGridTextColumn Header="Instance ID" Binding="{Binding InstanceId}"       Width="150" MinWidth="130"/>
                        <DataGridTextColumn Header="Type"        Binding="{Binding InstanceType}"     Width="100" MinWidth="80"/>
                        <DataGridTextColumn Header="Public IP"   Binding="{Binding PublicIpAddress}"  Width="120" MinWidth="100"/>
                        <DataGridTextColumn Header="Private IP"  Binding="{Binding PrivateIpAddress}" Width="120" MinWidth="100"/>
                        <DataGridTextColumn Header="Launch Time" Binding="{Binding LaunchTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="140" MinWidth="130"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Selection count bar — bottom of left panel -->
                <Border Grid.Row="1"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,12,12"
                        Padding="16,10"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisible}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" FontSize="12" FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
                            <Run Text="selected"/>
                        </TextBlock>

                        <TextBlock Grid.Column="1" Margin="12,0,0,0"
                                   Text="Ctrl+A para selecionar tudo"
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!-- Detail side panel — visible when any selection exists -->
        <Border Grid.Column="2" Margin="0"
                Style="{StaticResource Card}" Padding="0"
                Visibility="{Binding HasSelection,
                             Converter={StaticResource BoolToVisible}}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Batch action bar -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="12,12,0,0"
                        Padding="14,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                        <!-- Start -->
                        <Button Style="{StaticResource GhostButton}"
                                Command="{Binding StartInstanceCommand}"
                                Foreground="{DynamicResource SuccessBrush}" Padding="9,6"
                                ToolTip="Start instance">
                            <TextBlock Text="▶" FontSize="11"/>
                        </Button>

                        <!-- Stop -->
                        <Button Style="{StaticResource GhostButton}"
                                Command="{Binding StopInstanceCommand}"
                                Foreground="{DynamicResource DangerBrush}" Padding="9,6" Margin="2,0"
                                ToolTip="Stop instance">
                            <TextBlock Text="■" FontSize="11"/>
                        </Button>

                        <!-- Reboot -->
                        <Button Style="{StaticResource GhostButton}"
                                Command="{Binding RebootInstanceCommand}"
                                Foreground="{DynamicResource WarningBrush}" Padding="9,6" Margin="2,0"
                                ToolTip="Reboot instance">
                            <TextBlock Text="↺" FontSize="13"/>
                        </Button>

                        <!-- Terminate -->
                        <Button Style="{StaticResource GhostButton}"
                                Command="{Binding TerminateInstanceCommand}"
                                Foreground="{DynamicResource DangerBrush}" Padding="9,6" Margin="2,0"
                                ToolTip="Terminate instance">
                            <TextBlock Text="⊗" FontSize="13"/>
                        </Button>

                        <!-- Divider -->
                        <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="4,4" VerticalAlignment="Stretch"/>

                        <!-- Connect via SSM Session Manager -->
                        <Button Style="{StaticResource GhostButton}"
                                Command="{Binding ConnectSsmCommand}"
                                Foreground="{DynamicResource AccentBrush}" Padding="9,6"
                                ToolTip="Connect via SSM Session Manager">
                            <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                        </Button>

                        <!-- Divider -->
                        <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="4,4" VerticalAlignment="Stretch"/>

                        <!-- Clear selection -->
                        <Button Style="{StaticResource GhostButton}"
                                Click="InstanceGrid_ClearSelection"
                                Foreground="{DynamicResource TextMutedBrush}" Padding="9,6"
                                ToolTip="Clear selection">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                        </Button>

                    </StackPanel>
                </Border>

                <!-- ── Metrics section — fixed, always visible when 1 instance selected ── -->
                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,12"
                        Visibility="{Binding SelectedInstance,
                                     Converter={StaticResource NullToCollapsed}}">
                    <StackPanel>

                        <!-- Header -->
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Metrics · last 1h" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Loading…" FontSize="11" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsMetricsLoading,
                                                    Converter={StaticResource BoolToVisible}}"/>
                        </Grid>

                        <!-- Error -->
                        <TextBlock Text="{Binding MetricsError}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,6"
                                   Visibility="{Binding MetricsError,
                                                Converter={StaticResource NullToCollapsed}}"/>

                        <!-- 2 × 2 metric cards -->
                        <UniformGrid Columns="2">

                            <!-- CPU Utilization -->
                            <Border Margin="0,0,4,4" Padding="10,8" CornerRadius="8"
                                    Background="{DynamicResource SidebarActiveBrush}">
                                <StackPanel>
                                    <TextBlock Text="CPU Utilization" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding CpuLastText}" FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,0,0,6"/>
                                    <Viewbox Height="26" HorizontalAlignment="Stretch" Stretch="Fill">
                                        <Canvas Width="100" Height="26">
                                            <Polyline
                                                Points="{Binding SelectedMetrics.CpuUtilization,
                                                         Converter={StaticResource Sparkline}}"
                                                Stroke="{DynamicResource AccentBrush}"
                                                StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </StackPanel>
                            </Border>

                            <!-- Network In -->
                            <Border Margin="4,0,0,4" Padding="10,8" CornerRadius="8"
                                    Background="{DynamicResource SidebarActiveBrush}">
                                <StackPanel>
                                    <TextBlock Text="Network In" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding NetInLastText}" FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,0,0,6"/>
                                    <Viewbox Height="26" HorizontalAlignment="Stretch" Stretch="Fill">
                                        <Canvas Width="100" Height="26">
                                            <Polyline
                                                Points="{Binding SelectedMetrics.NetworkIn,
                                                         Converter={StaticResource Sparkline}}"
                                                Stroke="{DynamicResource SuccessBrush}"
                                                StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </StackPanel>
                            </Border>

                            <!-- Network Out -->
                            <Border Margin="0,4,4,0" Padding="10,8" CornerRadius="8"
                                    Background="{DynamicResource SidebarActiveBrush}">
                                <StackPanel>
                                    <TextBlock Text="Network Out" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding NetOutLastText}" FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,0,0,6"/>
                                    <Viewbox Height="26" HorizontalAlignment="Stretch" Stretch="Fill">
                                        <Canvas Width="100" Height="26">
                                            <Polyline
                                                Points="{Binding SelectedMetrics.NetworkOut,
                                                         Converter={StaticResource Sparkline}}"
                                                Stroke="{DynamicResource WarningBrush}"
                                                StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </StackPanel>
                            </Border>

                            <!-- Disk Write -->
                            <Border Margin="4,4,0,0" Padding="10,8" CornerRadius="8"
                                    Background="{DynamicResource SidebarActiveBrush}">
                                <StackPanel>
                                    <TextBlock Text="Disk Write" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding DiskWriteLastText}" FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,0,0,6"/>
                                    <Viewbox Height="26" HorizontalAlignment="Stretch" Stretch="Fill">
                                        <Canvas Width="100" Height="26">
                                            <Polyline
                                                Points="{Binding SelectedMetrics.DiskWriteBytes,
                                                         Converter={StaticResource Sparkline}}"
                                                Stroke="#C084FC"
                                                StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </StackPanel>
                            </Border>

                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Detail content — visible only when exactly 1 instance is selected -->
                <ScrollViewer Grid.Row="2"
                              DataContext="{Binding DataContext.SelectedInstance, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,2,0"
                              Visibility="{Binding DataContext.SelectedInstance,
                                           RelativeSource={RelativeSource AncestorType=UserControl},
                                           Converter={StaticResource NullToCollapsed}}">
                <StackPanel>

                    <!-- ── Panel header ── -->
                    <Border Padding="18,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding InstanceId}" FontSize="11" FontFamily="Consolas"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- State badge -->
                            <Border Grid.Column="1" CornerRadius="5" Padding="8,3"
                                    VerticalAlignment="Center" Margin="10,0,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="running">
                                                <Setter Property="Background" Value="#1A4ADE80"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="stopped">
                                                <Setter Property="Background" Value="#1AF87171"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="pending">
                                                <Setter Property="Background" Value="#1AFBBF24"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="stopping">
                                                <Setter Property="Background" Value="#1AFBBF24"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="terminated">
                                                <Setter Property="Background" Value="#1A6B7280"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11" FontWeight="Medium">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding State}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="running">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="stopped">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="pending">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="stopping">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="terminated">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ════════════════════════════════════════════
                         SECTION: Instance summary
                    ════════════════════════════════════════════ -->
                    <Border Padding="18,14,18,0">
                        <StackPanel>
                            <TextBlock Text="Instance summary" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                            <UniformGrid Columns="2">

                                <StackPanel Margin="0,0,12,14">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="Instance ID" FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Button Tag="{Binding InstanceId}" Click="CopyButton_Click"
                                                Style="{StaticResource GhostButton}"
                                                Padding="4,0" Margin="4,0,0,0" Height="16"
                                                ToolTip="Copy Instance ID">
                                            <TextBlock Text="⧉" FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="{Binding InstanceId}" FontSize="12" FontFamily="Consolas"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap" ToolTip="{Binding InstanceId}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Instance state" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding State}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,12,14">
                                    <TextBlock Text="Instance type" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding InstanceType}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="vCPUs" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding VCpuCount}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,12,14">
                                    <TextBlock Text="Public IPv4 address" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding PublicIpAddress}" FontSize="12" FontFamily="Consolas"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Private IPv4 address" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding PrivateIpAddress}" FontSize="12" FontFamily="Consolas"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,12,14">
                                    <TextBlock Text="IPv6 address" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding Ipv6Address}" FontSize="12" FontFamily="Consolas"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Region" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding Region}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>

                            </UniformGrid>

                            <!-- Full-width fields -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Public DNS" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding PublicDnsName}" FontSize="12" FontFamily="Consolas"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Private IP DNS name (IPv4 only)" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding PrivateDnsName}" FontSize="12" FontFamily="Consolas"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <UniformGrid Columns="2">

                                <StackPanel Margin="0,0,12,14">
                                    <TextBlock Text="VPC ID" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding VpcId}" FontSize="12" FontFamily="Consolas"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap" ToolTip="{Binding VpcId}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Subnet ID" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding SubnetId}" FontSize="12" FontFamily="Consolas"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap" ToolTip="{Binding SubnetId}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,12,14">
                                    <TextBlock Text="IAM role" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding IamInstanceProfileName}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap" ToolTip="{Binding IamInstanceProfileArn}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Auto Scaling Group" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding AutoScalingGroupName}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,12,14">
                                    <TextBlock Text="IMDSv2" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding MetadataHttpTokens}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Owner" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding OwnerId}" FontSize="12" FontFamily="Consolas"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>

                            </UniformGrid>

                            <StackPanel Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="Instance ARN" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button Tag="{Binding InstanceArn}" Click="CopyButton_Click"
                                            Style="{StaticResource GhostButton}"
                                            Padding="4,0" Margin="4,0,0,0" Height="16"
                                            ToolTip="Copy Instance ARN">
                                        <TextBlock Text="⧉" FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{Binding InstanceArn}" FontSize="11" FontFamily="Consolas"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" ToolTip="{Binding InstanceArn}"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>

                    <!-- ════════════════════════════════════════════
                         SECTION: Instance details
                    ════════════════════════════════════════════ -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                            Padding="18,14,18,0" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="Instance details" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                            <UniformGrid Columns="2">

                                <StackPanel Margin="0,0,12,14">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="AMI ID" FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Button Tag="{Binding ImageId}" Click="CopyButton_Click"
                                                Style="{StaticResource GhostButton}"
                                                Padding="4,0" Margin="4,0,0,0" Height="16"
                                                ToolTip="Copy AMI ID">
                                            <TextBlock Text="⧉" FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ImageId}" FontSize="12" FontFamily="Consolas"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Monitoring" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding MonitoringState}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,12,14">
                                    <TextBlock Text="Platform details" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding PlatformDetails}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Key pair assigned at launch" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding KeyName}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,12,14">
                                    <TextBlock Text="Launch time" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding LaunchTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                               FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Virtualization type" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding VirtualizationType}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,12,14">
                                    <TextBlock Text="Lifecycle" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding Lifecycle}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Usage operation" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding UsageOperation}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,12,14">
                                    <TextBlock Text="Credit specification" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding CreditSpecification}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Boot mode" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding BootMode}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,12,14">
                                    <TextBlock Text="Current instance boot mode" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding CurrentInstanceBootMode}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="AMI launch index" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding AmiLaunchIndex}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>

                            </UniformGrid>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="State transition message" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding StateTransitionReason}" FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>

                    <!-- ════════════════════════════════════════════
                         SECTION: Host and placement group
                    ════════════════════════════════════════════ -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                            Padding="18,14,18,0" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="Host and placement group" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                            <UniformGrid Columns="2">

                                <StackPanel Margin="0,0,12,14">
                                    <TextBlock Text="Tenancy" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding Tenancy}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Host ID" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding HostId}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,12,14">
                                    <TextBlock Text="Affinity" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding Affinity}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Placement group" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding PlacementGroup}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,12,14">
                                    <TextBlock Text="Placement group ID" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding PlacementGroupId}" FontSize="12" FontFamily="Consolas"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Partition number" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding PartitionNumber}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,12,14">
                                    <TextBlock Text="Reservation" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding ReservationId}" FontSize="12" FontFamily="Consolas"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Number of vCPUs" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding VCpuCount}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>

                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- ════════════════════════════════════════════
                         SECTION: Capacity reservation
                    ════════════════════════════════════════════ -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                            Padding="18,14,18,18" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="Capacity reservation" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                            <UniformGrid Columns="2">

                                <StackPanel Margin="0,0,12,14">
                                    <TextBlock Text="Capacity Reservation ID" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding CapacityReservationId}" FontSize="12" FontFamily="Consolas"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Capacity Reservation setting" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding CapacityReservationPreference}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>

                            </UniformGrid>
                        </StackPanel>
                    </Border>

                </StackPanel>
                </ScrollViewer>


            </Grid>
        </Border>

        </Grid><!-- end main content grid -->

        </Grid><!-- end main content wrapper -->
    </Grid>
</UserControl>
