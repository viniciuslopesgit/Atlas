<Window x:Class="Atlas.Views.CreateBucketDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        Background="{DynamicResource SurfaceBrush}"
        ResizeMode="NoResize"
        Width="560" Height="720"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>

        <!-- ── Radio button for form ──────────────────────────────── -->
        <Style x:Key="FormRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Ring" Width="16" Height="16" CornerRadius="8"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                                    Background="Transparent" Margin="0,0,10,0" SnapsToDevicePixels="True">
                                <Border x:Name="Dot" Width="8" Height="8" CornerRadius="4"
                                        Background="Transparent"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Dot"  Property="Background"  Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Inline checkbox row (checkbox + label) ─────────────── -->
        <Style x:Key="FormCheck" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <BulletDecorator Background="Transparent" SnapsToDevicePixels="True">
                            <BulletDecorator.Bullet>
                                <Border x:Name="checkBorder" Width="16" Height="16" CornerRadius="4"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                                        Background="Transparent">
                                    <TextBlock x:Name="checkMark" Text="&#xE73E;"
                                               FontFamily="Segoe MDL2 Assets" FontSize="9"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="White" Visibility="Collapsed"/>
                                </Border>
                            </BulletDecorator.Bullet>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="checkMark"   Property="Visibility"  Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="checkBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Section header ─────────────────────────────────────── -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- ── Hint text ──────────────────────────────────────────── -->
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <!-- ── Field label ────────────────────────────────────────── -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- ── Section divider ────────────────────────────────────── -->
        <Style x:Key="SectionDiv" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Margin" Value="0,18,0,18"/>
        </Style>

    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="14">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- header -->
                <RowDefinition Height="*"/>      <!-- form   -->
                <RowDefinition Height="Auto"/>   <!-- footer -->
            </Grid.RowDefinitions>

            <!-- ── Header ─────────────────────────────────────────── -->
            <Border Grid.Row="0" x:Name="DragHandle" Padding="24,20,20,16"
                    MouseLeftButtonDown="DragHandle_MouseDown" Cursor="SizeAll"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="10" Margin="0,0,14,0">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource AccentColor}" Opacity="0.15"/>
                            </Border.Background>
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Create S3 Bucket" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="RegionBadgeText" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Click="Cancel_Click" Style="{StaticResource GhostButton}"
                            Padding="8" VerticalAlignment="Top">
                        <TextBlock Text="✕" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ── Scrollable form ────────────────────────────────── -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,4,0">
                <StackPanel Margin="24,18,24,4">

                    <!-- ── Bucket Name ───────────────────────────── -->
                    <TextBlock Text="Bucket name" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource InputBorder}" Height="34">
                        <TextBox x:Name="TxtBucketName" Style="{x:Null}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontSize="13" Padding="11,0"
                                 VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 TextChanged="TxtBucketName_TextChanged"/>
                    </Border>
                    <TextBlock x:Name="TxtNameError" Foreground="{DynamicResource DangerBrush}"
                               FontSize="11" Margin="0,4,0,0" Visibility="Collapsed"
                               TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource HintText}"
                               Text="3–63 characters · lowercase letters, numbers, hyphens and periods · must start and end with a letter or number"/>

                    <!-- ── Region ─────────────────────────────────── -->
                    <TextBlock Text="AWS Region" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                    <ComboBox x:Name="CmbRegion" Height="34"
                              SelectionChanged="CmbRegion_SelectionChanged"/>

                    <Border Style="{StaticResource SectionDiv}"/>

                    <!-- ── Object Ownership ───────────────────────── -->
                    <TextBlock Text="Object Ownership" Style="{StaticResource SectionHeader}"/>

                    <RadioButton x:Name="RdoAclsDisabled" Style="{StaticResource FormRadio}"
                                 GroupName="Ownership" IsChecked="True">
                        <StackPanel>
                            <TextBlock Text="ACLs disabled (recommended)" FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="All objects owned by this account. Access controlled via policies only."
                                       Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="RdoAclsEnabled" Style="{StaticResource FormRadio}"
                                 GroupName="Ownership" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="ACLs enabled" FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Objects can be owned by other AWS accounts. Access via ACLs."
                                       Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <Border Style="{StaticResource SectionDiv}"/>

                    <!-- ── Block Public Access ────────────────────── -->
                    <TextBlock Text="Block Public Access" Style="{StaticResource SectionHeader}"/>

                    <!-- Master toggle -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox x:Name="ChkBlockAll" Style="{StaticResource FormCheck}"
                                  IsChecked="True" Checked="BlockAll_Checked" Unchecked="BlockAll_Unchecked"/>
                        <TextBlock Text="Block all public access" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Individual toggles -->
                    <StackPanel x:Name="PnlBlockDetails" Margin="26,0,0,0">

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <CheckBox x:Name="ChkBlockNewAcls" Style="{StaticResource FormCheck}"
                                      IsChecked="True" Checked="IndividualBlock_Changed" Unchecked="IndividualBlock_Changed"/>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="Block public access granted through new ACLs"
                                           FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <CheckBox x:Name="ChkBlockExistingAcls" Style="{StaticResource FormCheck}"
                                      IsChecked="True" Checked="IndividualBlock_Changed" Unchecked="IndividualBlock_Changed"/>
                            <TextBlock Text="Block public access granted through any ACLs"
                                       FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="10,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <CheckBox x:Name="ChkBlockNewPolicies" Style="{StaticResource FormCheck}"
                                      IsChecked="True" Checked="IndividualBlock_Changed" Unchecked="IndividualBlock_Changed"/>
                            <TextBlock Text="Block public access granted through new bucket policies"
                                       FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="10,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <CheckBox x:Name="ChkBlockCrossAccount" Style="{StaticResource FormCheck}"
                                      IsChecked="True" Checked="IndividualBlock_Changed" Unchecked="IndividualBlock_Changed"/>
                            <TextBlock Text="Block public and cross-account access via any public policies"
                                       FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="10,0,0,0"/>
                        </StackPanel>

                    </StackPanel>

                    <Border Style="{StaticResource SectionDiv}"/>

                    <!-- ── Versioning ─────────────────────────────── -->
                    <TextBlock Text="Bucket Versioning" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="Keep multiple variants of an object in the same bucket."
                               Style="{StaticResource HintText}" Margin="0,0,0,10"/>

                    <RadioButton x:Name="RdoVersioningDisable" Style="{StaticResource FormRadio}"
                                 GroupName="Versioning" IsChecked="True">
                        <TextBlock Text="Disabled" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </RadioButton>
                    <RadioButton x:Name="RdoVersioningEnable" Style="{StaticResource FormRadio}"
                                 GroupName="Versioning" Margin="0,4,0,0">
                        <TextBlock Text="Enabled" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </RadioButton>

                    <Border Style="{StaticResource SectionDiv}"/>

                    <!-- ── Default Encryption ─────────────────────── -->
                    <TextBlock Text="Default Encryption" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="Server-side encryption is automatically applied to new objects."
                               Style="{StaticResource HintText}" Margin="0,0,0,10"/>

                    <RadioButton x:Name="RdoSseS3" Style="{StaticResource FormRadio}"
                                 GroupName="Encryption" IsChecked="True"
                                 Checked="Encryption_Changed">
                        <StackPanel>
                            <TextBlock Text="SSE-S3" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Server-side encryption with Amazon S3 managed keys"
                                       Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="RdoSseKms" Style="{StaticResource FormRadio}"
                                 GroupName="Encryption" Margin="0,6,0,0"
                                 Checked="Encryption_Changed">
                        <StackPanel>
                            <TextBlock Text="SSE-KMS" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Server-side encryption with AWS KMS keys"
                                       Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="RdoDsseKms" Style="{StaticResource FormRadio}"
                                 GroupName="Encryption" Margin="0,6,0,0"
                                 Checked="Encryption_Changed">
                        <StackPanel>
                            <TextBlock Text="DSSE-KMS" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Dual-layer server-side encryption with AWS KMS keys"
                                       Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- KMS options (shown for SSE-KMS / DSSE-KMS) -->
                    <StackPanel x:Name="PnlKmsOptions" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock Text="KMS Key ARN (optional — leave blank to use default aws/s3 key)"
                                   Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource InputBorder}" Height="34">
                            <TextBox x:Name="TxtKmsKey" Style="{x:Null}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     FontFamily="Consolas" FontSize="12" Padding="11,0"
                                     VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                     ToolTip="Enter full KMS key ARN, e.g. arn:aws:kms:us-east-1:123456789012:key/…"/>
                        </Border>
                    </StackPanel>

                    <!-- Bucket Key (shown for SSE-KMS only) -->
                    <StackPanel x:Name="PnlBucketKey" Margin="0,10,0,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="ChkBucketKey" Style="{StaticResource FormCheck}" IsChecked="True"/>
                            <TextBlock Text="Enable Bucket Key" FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Reduces SSE-KMS costs by lowering AWS KMS API calls."
                                   Style="{StaticResource HintText}" Margin="26,2,0,0"/>
                    </StackPanel>

                    <Border Style="{StaticResource SectionDiv}"/>

                    <!-- ── Tags ───────────────────────────────────── -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Tags (optional)"
                                   Style="{StaticResource SectionHeader}" Margin="0"/>
                        <Button Grid.Column="1" x:Name="BtnAddTag"
                                Style="{StaticResource GhostButton}"
                                Click="AddTag_Click" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Add tag" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Tag rows dynamically added here -->
                    <StackPanel x:Name="PnlTags"/>

                    <TextBlock x:Name="TxtTagsHint"
                               Text="No tags added. You can add up to 50 tags."
                               Style="{StaticResource HintText}"/>

                    <Border Style="{StaticResource SectionDiv}"/>

                    <!-- ── Object Lock ────────────────────────────── -->
                    <TextBlock Text="Object Lock" Style="{StaticResource SectionHeader}"/>

                    <!-- Warning note -->
                    <Border CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                            Background="#1AFBBF24" BorderBrush="#33FBBF24" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠" FontSize="13" Foreground="{DynamicResource WarningBrush}"
                                       Margin="0,0,8,0" VerticalAlignment="Top"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="Enabling Object Lock permanently allows objects in this bucket to be locked (WORM model). "/>
                                <Run Text="This also automatically enables Versioning and cannot be undone." FontWeight="Medium"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <RadioButton x:Name="RdoLockDisable" Style="{StaticResource FormRadio}"
                                 GroupName="ObjectLock" IsChecked="True"
                                 Checked="ObjectLock_Changed">
                        <TextBlock Text="Disabled" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </RadioButton>
                    <RadioButton x:Name="RdoLockEnable" Style="{StaticResource FormRadio}"
                                 GroupName="ObjectLock" Margin="0,4,0,0"
                                 Checked="ObjectLock_Changed">
                        <TextBlock Text="Enabled" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </RadioButton>

                    <!-- bottom padding -->
                    <Border Height="8"/>

                </StackPanel>
            </ScrollViewer>

            <!-- ── Footer ─────────────────────────────────────────── -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="20,14,20,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <UIElement Grid.Column="0"/>

                    <Button x:Name="BtnCancel" Grid.Column="1"
                            Style="{StaticResource GhostButton}"
                            Click="Cancel_Click" Padding="16,8" Margin="0,0,8,0">
                        <TextBlock Text="Cancel" FontSize="13"/>
                    </Button>

                    <Button x:Name="BtnCreate" Grid.Column="2"
                            Click="Create_Click" Padding="18,8">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{DynamicResource AccentBrush}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="Create bucket" FontSize="13" FontWeight="Medium" Foreground="White"/>
                    </Button>

                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
