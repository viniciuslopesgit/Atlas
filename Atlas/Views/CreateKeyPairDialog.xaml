<Window x:Class="Atlas.Views.CreateKeyPairDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        Background="{DynamicResource SurfaceBrush}"
        ResizeMode="NoResize"
        Width="480" Height="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="FormRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,4,16,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Ring" Width="16" Height="16" CornerRadius="8"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                                    Background="Transparent" Margin="0,0,8,0" SnapsToDevicePixels="True">
                                <Border x:Name="Dot" Width="8" Height="8" CornerRadius="4"
                                        Background="Transparent"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Dot"  Property="Background"  Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" x:Name="DragHandle" Padding="24,18,20,14"
                    MouseLeftButtonDown="DragHandle_MouseDown" Cursor="SizeAll"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="9" Margin="0,0,12,0">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource AccentColor}" Opacity="0.15"/>
                            </Border.Background>
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                        <TextBlock Text="Create key pair" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Click="Cancel_Click" Style="{StaticResource GhostButton}"
                            Padding="8" VerticalAlignment="Top">
                        <TextBlock Text="✕" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Form -->
            <StackPanel Grid.Row="1" Margin="24,18,24,4">

                <!-- Name -->
                <TextBlock Text="Key pair name" FontSize="12" FontWeight="Medium"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <Border Style="{StaticResource InputBorder}" Height="34">
                    <TextBox x:Name="TxtName" Style="{x:Null}"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="13" Padding="11,0"
                             VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                             CaretBrush="{DynamicResource AccentBrush}"/>
                </Border>
                <TextBlock x:Name="TxtNameError" Foreground="{DynamicResource DangerBrush}"
                           FontSize="11" Margin="0,4,0,0" Visibility="Collapsed"/>
                <TextBlock Text="Max 255 characters. Must be unique within the region."
                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>

                <!-- Key type -->
                <TextBlock Text="Key pair type" FontSize="12" FontWeight="Medium"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,16,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RdoRsa" Style="{StaticResource FormRadio}"
                                 GroupName="KeyType" IsChecked="True">
                        <StackPanel>
                            <TextBlock Text="RSA" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Supported by all SSH clients" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="RdoEd25519" Style="{StaticResource FormRadio}"
                                 GroupName="KeyType">
                        <StackPanel>
                            <TextBlock Text="ED25519" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Faster, shorter keys (OpenSSH 6.5+)" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- File format -->
                <TextBlock Text="Private key file format" FontSize="12" FontWeight="Medium"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,16,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RdoPem" Style="{StaticResource FormRadio}"
                                 GroupName="Format" IsChecked="True">
                        <StackPanel>
                            <TextBlock Text=".pem" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="OpenSSH / Linux / macOS" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="RdoPpk" Style="{StaticResource FormRadio}"
                                 GroupName="Format">
                        <StackPanel>
                            <TextBlock Text=".ppk" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="PuTTY (Windows)" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- PPK note -->
                <Border x:Name="PnlPpkNote" CornerRadius="8" Padding="12,8" Margin="0,8,0,0"
                        Background="#1AFBBF24" BorderBrush="#33FBBF24" BorderThickness="1"
                        Visibility="Collapsed">
                    <TextBlock TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        AWS provides keys in PEM format. The key will be saved as <Run Text=".pem" FontWeight="Medium"/>
                        content with a <Run Text=".ppk" FontWeight="Medium"/> extension.
                        Use PuTTYgen to convert to native PPK format if needed.
                    </TextBlock>
                </Border>

                <!-- Error -->
                <TextBlock x:Name="TxtError" Foreground="{DynamicResource DangerBrush}"
                           FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                           Visibility="Collapsed"/>

            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="20,12,20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <UIElement Grid.Column="0"/>
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                            Click="Cancel_Click" Padding="14,8" Margin="0,0,8,0">
                        <TextBlock Text="Cancel" FontSize="13"/>
                    </Button>
                    <Button Grid.Column="2" x:Name="BtnCreate" Click="Create_Click" Padding="18,8">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{DynamicResource AccentBrush}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtBtnLabel" Text="Create key pair" FontSize="13"
                                       FontWeight="Medium" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
