<Window x:Class="Atlas.Views.AddAccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        Background="{DynamicResource SurfaceBrush}"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="0">
        <StackPanel>

            <!-- Drag handle / header -->
            <Border x:Name="DragHandle" Padding="24,20,20,16"
                    MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                    Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="10" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource AccentColor}" Opacity="0.15"/>
                            </Border.Background>
                            <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                        <TextBlock Text="Add AWS Account" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1" Click="Cancel_Click"
                            Style="{StaticResource GhostButton}"
                            Padding="8" VerticalAlignment="Top">
                        <TextBlock Text="✕" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Divider -->
            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="24,0,24,20"/>

            <!-- Form -->
            <StackPanel Margin="24,0,24,0">

                <!-- Account Name -->
                <TextBlock Text="Account Name" FontSize="12" FontWeight="Medium"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <Border Style="{StaticResource InputBorder}" Height="36" Margin="0,0,0,16">
                    <TextBox x:Name="TxtName" Style="{x:Null}"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="13" Padding="11,0"
                             VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                             CaretBrush="{DynamicResource AccentBrush}"/>
                </Border>

                <!-- Access Key ID + Secret Access Key (two columns) -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Access Key ID" FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource InputBorder}" Height="36">
                            <TextBox x:Name="TxtAccessKey" Style="{x:Null}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     FontFamily="Consolas" FontSize="12" Padding="11,0"
                                     VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                     CaretBrush="{DynamicResource AccentBrush}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Secret Access Key" FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource InputBorder}" Height="36">
                            <PasswordBox x:Name="PbSecretKey" Style="{x:Null}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         FontFamily="Consolas" FontSize="12" Padding="11,0"
                                         VerticalAlignment="Stretch" VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Default Region -->
                <TextBlock Text="Default Region" FontSize="12" FontWeight="Medium"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <ComboBox x:Name="CmbRegion" Height="36" Margin="0,0,0,0"
                          FontFamily="Consolas" FontSize="13"/>

                <!-- Optional description -->
                <TextBlock Text="Description (optional)" FontSize="12" FontWeight="Medium"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,16,0,6"/>
                <Border Style="{StaticResource InputBorder}" Height="36" Margin="0,0,0,0">
                    <TextBox x:Name="TxtDescription" Style="{x:Null}"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="13" Padding="11,0"
                             VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                             CaretBrush="{DynamicResource AccentBrush}"/>
                </Border>
            </StackPanel>

            <!-- Validation feedback -->
            <Border x:Name="FeedbackBorder" Margin="24,16,24,0" CornerRadius="8" Padding="12,9"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="FeedbackIcon" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="FeedbackText" FontSize="13" TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Divider -->
            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,20,0,0"/>

            <!-- Footer -->
            <Grid Margin="20,14,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <UIElement Grid.Column="0"/>

                <Button x:Name="BtnCancel" Grid.Column="1"
                        Style="{StaticResource GhostButton}"
                        Click="Cancel_Click"
                        Padding="16,8" Margin="0,0,8,0">
                    <TextBlock Text="Cancel" FontSize="13"/>
                </Button>

                <Button x:Name="BtnAdd" Grid.Column="2"
                        Click="Add_Click"
                        Padding="16,8">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="BtnIcon" Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"
                                   Foreground="White"/>
                        <TextBlock x:Name="BtnText" Text="Validate &amp; Add Account"
                                   FontSize="13" FontWeight="Medium" Foreground="White"/>
                    </StackPanel>
                </Button>
            </Grid>

        </StackPanel>
    </Border>
</Window>
