<UserControl x:Class="Atlas.Views.TerraformView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!-- ToggleButton de recurso AWS: card clicável com realce quando activo -->
        <Style x:Key="ResourceToggleCard" TargetType="ToggleButton">
            <Setter Property="HorizontalAlignment"  Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment"   Value="Stretch"/>
            <Setter Property="Focusable"            Value="True"/>
            <Setter Property="Cursor"               Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="CardBorder"
                                CornerRadius="10" Padding="14,12"
                                BorderThickness="1.5"
                                Background="{DynamicResource SidebarActiveBrush}"
                                BorderBrush="{DynamicResource BorderBrush}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="CardBorder" Property="Background"
                                        Value="{DynamicResource BackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label de campo de formulário -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

        <!-- Wrapper de campo de input -->
        <Style x:Key="FieldRow" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource BackgroundBrush}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">

            <!-- ══════════════════════════════════════════════════
                 CABEÇALHO: título, subtítulo, badge versão
                 Visible for all sections
            ═══════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B8;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="20" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,0,10,0"/>
                        <TextBlock Text="Infrastructure as Code"
                                   FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Manage and deploy AWS infrastructure with Terraform"
                               FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                               Margin="30,4,0,0"/>
                </StackPanel>

                <!-- Indicador de execução + badge versão -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,4,0,0">

                    <!-- Running badge (visível quando a command está em execução) -->
                    <Border CornerRadius="6" Padding="10,5" Margin="0,0,8,0"
                            Background="{DynamicResource SidebarActiveBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCommandRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}"
                                     VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding ActiveCommandLabel}"
                                       FontSize="12" FontFamily="Consolas"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Versão do terraform -->
                    <Border CornerRadius="6" Padding="10,5"
                            Background="{DynamicResource SidebarActiveBrush}"
                            Visibility="{Binding TerraformVersion, Converter={StaticResource NullToCollapsed}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding TerraformVersion}"
                                       FontSize="12" FontFamily="Consolas"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ══════════════════════════════════════════════════
                 PROJETOS: lista (esquerda) + formulário (direita)
            ═══════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── Coluna esquerda: lista de projetos ─── -->
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">

                        <TextBlock Text="Projects" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,14"/>

                        <!-- Linhas de projeto -->
                        <ItemsControl ItemsSource="{Binding Projects}"
                                      Visibility="{Binding Projects.Count, Converter={StaticResource ZeroToCollapsed}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,10" Margin="0,0,0,8" CornerRadius="8"
                                            Background="{DynamicResource BackgroundBrush}"
                                            BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Barra de estado init -->
                                            <Border Grid.Column="0" Width="3" CornerRadius="2"
                                                    Margin="0,0,12,0" MinHeight="36">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInitialized}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- Nome + meta -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold" FontSize="13"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center"/>

                                                    <!-- Badge init / not init -->
                                                    <Border Margin="8,0,0,0" Padding="5,2" CornerRadius="4"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource SidebarActiveBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsInitialized}" Value="True">
                                                                        <Setter Property="Background" Value="#152A1A"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="10" FontWeight="Medium">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text"       Value="not initialized"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsInitialized}" Value="True">
                                                                            <Setter Property="Text"       Value="initialized"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Caminho -->
                                                <TextBlock Text="{Binding RootPath}" FontSize="11"
                                                           FontFamily="Consolas"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,0,2"/>

                                                <!-- workspace · backend -->
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}">
                                                    <Run Text="workspace: "/>
                                                    <Run Text="{Binding DefaultWorkspace}" FontFamily="Consolas"/>
                                                    <Run Text="  ·  backend: "/>
                                                    <Run Text="{Binding BackendType}" FontFamily="Consolas"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Botões de acção -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                        VerticalAlignment="Center">

                                                <Button Style="{StaticResource GhostButton}"
                                                        Command="{Binding DataContext.RunInitCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding DataContext.IsCommandRunning,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                                    Converter={StaticResource BoolInvert}}"
                                                        ToolTip="terraform init" Margin="0,0,2,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8B8;" FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="11" VerticalAlignment="Center"
                                                                   Margin="0,0,4,0"/>
                                                        <TextBlock Text="init" FontFamily="Consolas" FontSize="12"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Style="{StaticResource GhostButton}"
                                                        Command="{Binding DataContext.RunValidateCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding DataContext.IsCommandRunning,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                                    Converter={StaticResource BoolInvert}}"
                                                        ToolTip="terraform validate" Margin="0,0,2,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="11" VerticalAlignment="Center"
                                                                   Margin="0,0,4,0"/>
                                                        <TextBlock Text="validate" FontFamily="Consolas" FontSize="12"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Style="{StaticResource GhostButton}"
                                                        Command="{Binding DataContext.RunPlanCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding DataContext.IsCommandRunning,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                                    Converter={StaticResource BoolInvert}}"
                                                        ToolTip="terraform plan" Margin="0,0,2,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="11" VerticalAlignment="Center"
                                                                   Margin="0,0,4,0"/>
                                                        <TextBlock Text="plan" FontFamily="Consolas" FontSize="12"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Style="{StaticResource GhostButton}"
                                                        Command="{Binding DataContext.RunApplyCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding DataContext.IsCommandRunning,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                                    Converter={StaticResource BoolInvert}}"
                                                        ToolTip="terraform apply -auto-approve"
                                                        Margin="0,0,2,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="11" VerticalAlignment="Center"
                                                                   Margin="0,0,4,0"/>
                                                        <TextBlock Text="apply" FontFamily="Consolas" FontSize="12"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Style="{StaticResource GhostButton}"
                                                        Command="{Binding DataContext.RunOutputCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding DataContext.IsCommandRunning,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                                    Converter={StaticResource BoolInvert}}"
                                                        ToolTip="terraform output" Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="11" VerticalAlignment="Center"
                                                                   Margin="0,0,4,0"/>
                                                        <TextBlock Text="output" FontFamily="Consolas" FontSize="12"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Remover -->
                                                <Button Style="{StaticResource GhostButton}"
                                                        Command="{Binding DataContext.RemoveProjectCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Remove project"
                                                        Foreground="{DynamicResource DangerBrush}">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="12"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state -->
                        <Border CornerRadius="8" Padding="20,24" Margin="0,0,0,0"
                                Background="{DynamicResource BackgroundBrush}"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                Visibility="{Binding Projects.Count, Converter={StaticResource ZeroToVisible}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8B8;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="28" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource BorderBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="No projects configured yet"
                                           FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="Add a project on the right →"
                                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- ── Separador vertical ─── -->
                    <Border Grid.Column="1" Background="{DynamicResource BorderBrush}"
                            Margin="0,0,0,0"/>

                    <!-- ── Coluna direita: formulário de adição ─── -->
                    <StackPanel Grid.Column="2" Margin="20,0,0,0">

                        <TextBlock Text="Add Project" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,16"/>

                        <!-- Name -->
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock Text="NAME" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputBorder}" Height="32">
                                <TextBox Style="{x:Null}"
                                         Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Root path + Browse -->
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock Text="ROOT PATH" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource InputBorder}" Height="32">
                                    <TextBox Style="{x:Null}"
                                             Text="{Binding NewRootPath, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalAlignment="Center"/>
                                </Border>
                                <Button Grid.Column="2" x:Name="BrowsePathButton"
                                        Click="BrowsePath_Click"
                                        Style="{StaticResource GhostButton}"
                                        Width="32" Height="32"
                                        ToolTip="Browse folder">
                                    <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Workspace + Backend (2 colunas) -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="WORKSPACE" Style="{StaticResource FieldLabel}"/>
                                <Border Style="{StaticResource InputBorder}" Height="32">
                                    <TextBox Style="{x:Null}"
                                             Text="{Binding NewWorkspace, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="BACKEND" Style="{StaticResource FieldLabel}"/>
                                <Border Style="{StaticResource InputBorder}" Height="32" Padding="0">
                                    <ComboBox ItemsSource="{Binding BackendTypes}"
                                              SelectedItem="{Binding NewBackendType}"
                                              BorderThickness="0"
                                              Background="Transparent"
                                              VerticalAlignment="Center"
                                              Padding="8,0"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Auto-commit -->
                        <CheckBox Content="Auto-commit after sync"
                                  IsChecked="{Binding NewAutoCommit}"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  FontSize="12" Margin="0,0,0,14"/>

                        <!-- Mensagem de feedback -->
                        <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,10"
                                Visibility="{Binding AddMessage, Converter={StaticResource NullToCollapsed}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#3A1515"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AddSuccess}" Value="True">
                                            <Setter Property="Background" Value="#152A1A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding AddMessage}" FontSize="12" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AddSuccess}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- Botão de adicionar -->
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddProjectCommand}"
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" VerticalAlignment="Center"
                                           Margin="0,0,7,0"/>
                                <TextBlock Text="Add Project" FontSize="13"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════
                 IMPORT FROM AWS
            ═══════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>

                    <!-- Cabeçalho da secção -->
                    <TextBlock Text="Import from AWS"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,0,18" TextWrapping="Wrap">
                        Discover existing AWS resources and generate Terraform import blocks + HCL
                        into the active project.
                    </TextBlock>

                    <!-- Tipos de recurso — cards ToggleButton -->
                    <TextBlock Text="RESOURCE TYPES" Style="{StaticResource FieldLabel}"
                               Margin="0,0,0,8"/>

                    <UniformGrid Columns="4" Margin="0,0,0,18">

                        <!-- EC2 -->
                        <ToggleButton IsChecked="{Binding ImportEc2}"
                                      Style="{StaticResource ResourceToggleCard}"
                                      Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="&#xE7EF;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="22" Margin="0,0,0,6">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked,
                                                    RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                    Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="EC2 Instances"
                                           FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,2"/>
                                <TextBlock Text="Virtual machines"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </ToggleButton>

                        <!-- S3 -->
                        <ToggleButton IsChecked="{Binding ImportS3}"
                                      Style="{StaticResource ResourceToggleCard}"
                                      Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="22" Margin="0,0,0,6">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked,
                                                    RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                    Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="S3 Buckets"
                                           FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,2"/>
                                <TextBlock Text="Object storage"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </ToggleButton>

                        <!-- IAM -->
                        <ToggleButton IsChecked="{Binding ImportIam}"
                                      Style="{StaticResource ResourceToggleCard}"
                                      Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="22" Margin="0,0,0,6">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked,
                                                    RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                    Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="IAM"
                                           FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,2"/>
                                <TextBlock Text="Roles &amp; Users"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </ToggleButton>

                        <!-- Network -->
                        <ToggleButton IsChecked="{Binding ImportNetwork}"
                                      Style="{StaticResource ResourceToggleCard}">
                            <StackPanel>
                                <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="22" Margin="0,0,0,6">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked,
                                                    RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                    Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Network"
                                           FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,2"/>
                                <TextBlock Text="VPC / Subnet / SG"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </ToggleButton>

                    </UniformGrid>

                    <!-- Tag filter -->
                    <TextBlock Text="TAG FILTER (OPTIONAL)" Style="{StaticResource FieldLabel}"
                               Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Key" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <Border Style="{StaticResource InputBorder}" Height="32">
                                <TextBox Style="{x:Null}"
                                         Text="{Binding ImportTagKey, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Value (leave blank for any)" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <Border Style="{StaticResource InputBorder}" Height="32">
                                <TextBox Style="{x:Null}"
                                         Text="{Binding ImportTagValue, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Opções adicionais -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <CheckBox Content="Include terminated EC2"
                                  IsChecked="{Binding ImportIncludeTerminated}"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  FontSize="12" Margin="0,0,24,0"/>
                        <CheckBox Content="Include AWS-managed resources"
                                  IsChecked="{Binding ImportIncludeAwsManaged}"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  FontSize="12"/>
                    </StackPanel>

                    <!-- Botões de acção -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">

                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding RunImportCommand}"
                                IsEnabled="{Binding IsCommandRunning, Converter={StaticResource BoolInvert}}"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Import" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource GhostButton}"
                                Command="{Binding RunSyncCommand}"
                                IsEnabled="{Binding IsCommandRunning, Converter={StaticResource BoolInvert}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Full Sync" FontSize="13"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                    <!-- Resumo do resultado de import -->
                    <Border CornerRadius="8" Padding="12,10" Margin="0,14,0,0"
                            Background="{DynamicResource BackgroundBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                            Visibility="{Binding ImportResourcesFound, Converter={StaticResource ZeroToCollapsed}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Foreground="{DynamicResource SuccessBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessBrush}">
                                    <Run Text="{Binding ImportResourcesFound}"/>
                                    <Run Text=" resource(s) discovered and imported"/>
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                           Text="{Binding ImportFilesWritten}"
                                           FontFamily="Consolas" Margin="0,2,0,0"
                                           Visibility="{Binding ImportFilesWritten, Converter={StaticResource NullToCollapsed}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════
                 TERMINAL OUTPUT
            ═══════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource Card}"
                    Visibility="{Binding TerminalOutput, Converter={StaticResource NullToCollapsed}}">
                <StackPanel>

                    <!-- Cabeçalho do terminal -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ícone de estado -->
                        <TextBlock Grid.Column="0"
                                   FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text"       Value="&#xE73E;"/>
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCommandRunning}" Value="True">
                                            <Setter Property="Text"       Value="&#xE768;"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CommandResultSuccess}" Value="False">
                                            <Setter Property="Text"       Value="&#xEA39;"/>
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Etiqueta do comando / resultado -->
                        <TextBlock Grid.Column="1" FontSize="12" FontFamily="Consolas"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text"       Value="{Binding CommandResultMessage}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCommandRunning}" Value="True">
                                            <Setter Property="Text"       Value="{Binding ActiveCommandLabel}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CommandResultSuccess}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Duração -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding CommandDuration}"
                                   FontSize="11" FontFamily="Consolas"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="12,0,12,0"
                                   Visibility="{Binding CommandDuration, Converter={StaticResource NullToCollapsed}}"/>

                        <!-- Botão limpar -->
                        <Button Grid.Column="3"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding ClearTerminalCommand}"
                                ToolTip="Clear output"
                                Padding="6,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,0,4,0"/>
                                <TextBlock Text="Clear" FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Separador -->
                    <Border Height="1" Background="{DynamicResource BorderBrush}"
                            Margin="0,0,0,10"/>

                    <!-- Output raw -->
                    <ScrollViewer MaxHeight="280"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  x:Name="TerminalScroller">
                        <TextBlock Text="{Binding TerminalOutput}"
                                   FontFamily="Consolas" FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Padding="0"/>
                    </ScrollViewer>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
