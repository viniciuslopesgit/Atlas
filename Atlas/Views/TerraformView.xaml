<UserControl x:Class="Atlas.Views.TerraformView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Atlas.ViewModels">

    <ScrollViewer Background="{DynamicResource BackgroundBrush}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">

            <!-- ── Page title + versão do CLI ───────────────────────── -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Infrastructure as Code"
                           FontSize="24" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>

                <!-- Versão do terraform (badge) -->
                <Border Grid.Column="1" CornerRadius="6" Padding="10,4"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SidebarActiveBrush}"
                        Visibility="{Binding TerraformVersion, Converter={StaticResource NullToCollapsed}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding TerraformVersion}"
                                   FontSize="12" FontFamily="Consolas"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Configured Projects ────────────────────────────── -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                <StackPanel>

                    <TextBlock Text="Configured Projects" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                    <!-- Project rows -->
                    <ItemsControl ItemsSource="{Binding Projects}"
                                  Visibility="{Binding Projects.Count, Converter={StaticResource ZeroToCollapsed}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" Margin="0,0,0,8" CornerRadius="8"
                                        Background="{DynamicResource BackgroundBrush}"
                                        BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Init status bar -->
                                        <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="0,0,12,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInitialized}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <!-- Name + meta -->
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center"/>
                                                <!-- Init badge -->
                                                <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="4"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource SidebarActiveBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInitialized}" Value="True">
                                                                    <Setter Property="Background" Value="#152A1A"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="10" FontWeight="Medium">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Not initialized"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsInitialized}" Value="True">
                                                                        <Setter Property="Text" Value="Initialized"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding RootPath}" FontSize="11"
                                                       FontFamily="Consolas"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}">
                                                    <Run Text="workspace: "/>
                                                    <Run Text="{Binding DefaultWorkspace}" FontFamily="Consolas"/>
                                                    <Run Text="  ·  backend: "/>
                                                    <Run Text="{Binding BackendType}" FontFamily="Consolas"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Action buttons -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource GhostButton}"
                                                    Command="{Binding DataContext.RunInitCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding DataContext.IsCommandRunning,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                                Converter={StaticResource BoolInvert}}"
                                                    ToolTip="terraform init"
                                                    Margin="0,0,2,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8B8;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="11" VerticalAlignment="Center"
                                                               Margin="0,0,5,0"/>
                                                    <TextBlock Text="init" FontFamily="Consolas" FontSize="12"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Style="{StaticResource GhostButton}"
                                                    Command="{Binding DataContext.RunValidateCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding DataContext.IsCommandRunning,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                                Converter={StaticResource BoolInvert}}"
                                                    ToolTip="terraform validate"
                                                    Margin="0,0,2,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="11" VerticalAlignment="Center"
                                                               Margin="0,0,5,0"/>
                                                    <TextBlock Text="validate" FontFamily="Consolas" FontSize="12"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Style="{StaticResource GhostButton}"
                                                    Command="{Binding DataContext.RunPlanCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding DataContext.IsCommandRunning,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                                Converter={StaticResource BoolInvert}}"
                                                    ToolTip="terraform plan"
                                                    Margin="0,0,2,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="11" VerticalAlignment="Center"
                                                               Margin="0,0,5,0"/>
                                                    <TextBlock Text="plan" FontFamily="Consolas" FontSize="12"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Style="{StaticResource GhostButton}"
                                                    Command="{Binding DataContext.RunApplyCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding DataContext.IsCommandRunning,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                                Converter={StaticResource BoolInvert}}"
                                                    ToolTip="terraform apply -auto-approve"
                                                    Margin="0,0,2,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="11" VerticalAlignment="Center"
                                                               Margin="0,0,5,0"/>
                                                    <TextBlock Text="apply" FontFamily="Consolas" FontSize="12"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Style="{StaticResource GhostButton}"
                                                    Command="{Binding DataContext.RunOutputCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding DataContext.IsCommandRunning,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                                Converter={StaticResource BoolInvert}}"
                                                    ToolTip="terraform output"
                                                    Margin="0,0,4,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="11" VerticalAlignment="Center"
                                                               Margin="0,0,5,0"/>
                                                    <TextBlock Text="output" FontFamily="Consolas" FontSize="12"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Style="{StaticResource GhostButton}"
                                                    Command="{Binding DataContext.RemoveProjectCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="✕"
                                                    Foreground="{DynamicResource DangerBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state -->
                    <TextBlock Text="No projects configured yet."
                               FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,0"
                               Visibility="{Binding Projects.Count, Converter={StaticResource ZeroToVisible}}"/>

                    <!-- ── Terminal output ──────────────────────────────── -->
                    <Border CornerRadius="8" Padding="0"
                            Background="{DynamicResource BackgroundBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                            Margin="0,16,0,0"
                            Visibility="{Binding TerminalOutput, Converter={StaticResource NullToCollapsed}}">
                        <StackPanel>
                            <!-- Terminal header -->
                            <Border Padding="12,8"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Running spinner / done icon -->
                                    <TextBlock Grid.Column="0"
                                               FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE73E;"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCommandRunning}" Value="True">
                                                        <Setter Property="Text" Value="&#xE768;"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CommandResultSuccess}" Value="False">
                                                        <Setter Property="Text" Value="&#xEA39;"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Command label / result -->
                                    <TextBlock Grid.Column="1" FontSize="12" FontFamily="Consolas"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding CommandResultMessage}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCommandRunning}" Value="True">
                                                        <Setter Property="Text" Value="{Binding ActiveCommandLabel}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CommandResultSuccess}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Column="2" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsCommandRunning, Converter={StaticResource BoolToInvisible}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCommandRunning}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- Raw output -->
                            <ScrollViewer MaxHeight="240"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto"
                                          Padding="12,10">
                                <TextBlock Text="{Binding TerminalOutput}"
                                           FontFamily="Consolas" FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

            <!-- ── Add Project ────────────────────────────────────── -->
            <Border Style="{StaticResource Card}">
                <StackPanel>

                    <TextBlock Text="Add Project" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Project name -->
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Project Name" FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Backend type -->
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Backend Type" FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{x:Static vm:TerraformViewModel.BackendTypes}"
                                      SelectedItem="{Binding NewBackendType}"
                                      Height="38"/>
                        </StackPanel>

                        <!-- Root path + browse button -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                            <TextBlock Text="Root Path" FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding NewRootPath, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Consolas"/>
                                <Button Grid.Column="1"
                                        x:Name="BrowseButton"
                                        Click="BrowseButton_Click"
                                        Style="{StaticResource GhostButton}"
                                        ToolTip="Browse for folder"
                                        Margin="6,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8DA;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock Text="Browse" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Default workspace -->
                        <StackPanel Grid.Row="4" Grid.Column="0">
                            <TextBlock Text="Default Workspace" FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding NewWorkspace, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Auto-commit toggle -->
                        <StackPanel Grid.Row="4" Grid.Column="2" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Auto-commit on apply" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Commit state after terraform apply"
                                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                          IsChecked="{Binding NewAutoCommit, Mode=TwoWay}"
                                          Cursor="Hand" FocusVisualStyle="{x:Null}">
                                    <CheckBox.Template>
                                        <ControlTemplate TargetType="CheckBox">
                                            <Border x:Name="Track" Width="44" Height="24" CornerRadius="12"
                                                    Background="{DynamicResource BorderBrush}">
                                                <Border x:Name="Thumb" Width="18" Height="18" CornerRadius="9"
                                                        Background="White" HorizontalAlignment="Left"
                                                        Margin="3,0,0,0" VerticalAlignment="Center">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1"
                                                                          Opacity="0.25" Color="Black"/>
                                                    </Border.Effect>
                                                </Border>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Track" Property="Background"
                                                            Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </CheckBox.Template>
                                </CheckBox>
                            </Grid>
                        </StackPanel>

                        <!-- Submit row -->
                        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                                    Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}"
                                    Command="{Binding AddProjectCommand}"
                                    Content="Add Project"/>
                            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" FontSize="13"
                                       Text="{Binding AddMessage}"
                                       Visibility="{Binding AddMessage, Converter={StaticResource NullToCollapsed}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AddSuccess}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AddSuccess}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
