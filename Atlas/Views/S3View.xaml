<UserControl x:Class="Atlas.Views.S3View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Atlas.ViewModels">

    <Grid x:Name="RootGrid" Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="32,28,32,16">
            <TextBlock Text="S3 Buckets" FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
        </StackPanel>

        <!-- Main split -->
        <Grid Grid.Row="1" Margin="32,0,32,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="160" MaxWidth="560"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <GridSplitter Grid.Column="1"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          Cursor="SizeWE">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- ── Bucket list ──────────────────────────────────── -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Padding="12,10" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <!-- Title row -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Buckets" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Buckets.Count, StringFormat=' ({0})'}"
                                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding OpenCreateBucketCommand}"
                                        Padding="8,4" FontSize="11">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="Create bucket" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <!-- Search row -->
                            <Grid>
                                <TextBox x:Name="BucketSearchBox"
                                         Text="{Binding BucketFilterText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="13,0,8,0" Height="30"/>
                                <Viewbox Width="12" Height="12" HorizontalAlignment="Left"
                                         Margin="10,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center">
                                    <Canvas Width="16" Height="16">
                                        <Ellipse Canvas.Left="1" Canvas.Top="1" Width="10" Height="10"
                                                 Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.6"
                                                 Fill="Transparent"/>
                                        <Line X1="10" Y1="10" X2="15" Y2="15"
                                              Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Search buckets…" Margin="30,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=BucketSearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- DataGrid with multi-select -->
                    <DataGrid x:Name="BucketGrid" Grid.Row="1"
                              ItemsSource="{Binding Buckets}"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              SelectionChanged="BucketGrid_SelectionChanged"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent" BorderThickness="0"
                              GridLinesVisibility="None"
                              IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeColumns="False" CanUserReorderColumns="False"
                              CanUserSortColumns="False" AutoGenerateColumns="False"
                              RowHeight="60">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background"   Value="Transparent"/>
                                <Setter Property="BorderBrush"  Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="Height"       Value="32"/>
                                <Setter Property="Padding"      Value="0"/>
                                <Setter Property="Foreground"   Value="{DynamicResource TextMutedBrush}"/>
                                <Setter Property="FontSize"     Value="11"/>
                                <Setter Property="FontWeight"   Value="Medium"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridColumnHeader">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <!-- Checkbox — largura fixa, sem resize -->
                            <DataGridTemplateColumn Width="44" MinWidth="44"
                                                    CanUserResize="False" CanUserSort="False">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Focusable="False"
                                                  IsChecked="{Binding DataContext.AreAllBucketsSelected,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid},
                                                      Mode=OneWay}"
                                                  PreviewMouseLeftButtonDown="BucketSelectAll_PreviewMouseDown"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsSelected,
                                                      RelativeSource={RelativeSource AncestorType=DataGridRow},
                                                      Mode=OneWay}"
                                                  Focusable="False"
                                                  PreviewMouseLeftButtonDown="BucketRowCheckBox_PreviewMouseDown"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- Name + date -->
                            <DataGridTemplateColumn Width="*" MinWidth="80" Header="Bucket name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,6,8,6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding CreationDate, StringFormat='{}{0:yyyy-MM-dd}'}"
                                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Batch action bar -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,12,12"
                            Padding="10,8"
                            Visibility="{Binding HasBucketSelection, Converter={StaticResource BoolToVisible}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Count pill -->
                            <TextBlock Grid.Column="0" FontSize="11" FontWeight="Medium"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}">
                                <Run Text="{Binding SelectedBucketCount, Mode=OneWay}"/>
                                <Run Text="selected"/>
                            </TextBlock>

                            <!-- Actions -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Style="{StaticResource GhostButton}"
                                        Command="{Binding DeleteBucketCommand}"
                                        Foreground="{DynamicResource DangerBrush}" Padding="10,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Delete" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <!-- Divider -->
                                <Border Width="1" Background="{DynamicResource BorderBrush}"
                                        Margin="2,4" VerticalAlignment="Stretch"/>
                                <!-- Clear -->
                                <Button Style="{StaticResource GhostButton}"
                                        Click="BucketGrid_ClearSelection"
                                        Foreground="{DynamicResource TextMutedBrush}" Padding="8,5" Margin="2,0,0,0">
                                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>
            </Border>

            <!-- ── Object explorer ─────────────────────────────── -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- address bar -->
                        <RowDefinition Height="Auto"/>  <!-- toolbar -->
                        <RowDefinition Height="*"/>     <!-- content -->
                        <RowDefinition Height="Auto"/>  <!-- batch action bar -->
                    </Grid.RowDefinitions>

                    <!-- ── Address / breadcrumb bar ───────────────── -->
                    <Border Grid.Row="0" Padding="10,8"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Background="{DynamicResource BackgroundBrush}"
                            Visibility="{Binding SelectedBucket, Converter={StaticResource NullToCollapsed}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Up button -->
                            <Button Grid.Column="0"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding NavigateUpCommand}"
                                    Padding="6,4" Margin="0,0,6,0"
                                    ToolTip="Up one level">
                                <TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Button>

                            <!-- Breadcrumb segments -->
                            <ItemsControl Grid.Column="1"
                                          ItemsSource="{Binding Breadcrumbs}"
                                          VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Separator (hidden for first item) -->
                                            <TextBlock Text="›" FontSize="13" Margin="2,0"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- Segment button -->
                                            <Button Style="{StaticResource GhostButton}"
                                                    Padding="5,3"
                                                    Command="{Binding DataContext.NavigateToBreadcrumbCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding Label}" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- ── Toolbar ────────────────────────────────── -->
                    <Border Grid.Row="1" Padding="12,8"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Visibility="{Binding SelectedBucket, Converter={StaticResource NullToCollapsed}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Item count + size badge -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center">
                                    <Run Text="{Binding Objects.Count, Mode=OneWay}"/>
                                    <Run Text="items"/>
                                </TextBlock>
                                <Border CornerRadius="6" Padding="8,2" Margin="10,0,0,0"
                                        Background="{DynamicResource SidebarActiveBrush}"
                                        Visibility="{Binding HasSelectedBucketStats, Converter={StaticResource BoolToVisible}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SelectedBucketSizeText}"
                                                   FontSize="11" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text=" total" FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Actions -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}"
                                        Command="{Binding UploadFileCommand}" Margin="0,0,8,0"
                                        Padding="12,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="Upload" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}"
                                        Command="{Binding DownloadFileCommand}"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Padding="10,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="Download" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ── File/folder grid ───────────────────────── -->
                    <DataGrid x:Name="ObjectGrid" Grid.Row="2"
                              ItemsSource="{Binding Objects}"
                              Visibility="{Binding SelectedBucket, Converter={StaticResource NullToCollapsed}}"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserReorderColumns="False" CanUserSortColumns="True"
                              GridLinesVisibility="Horizontal"
                              Background="Transparent" BorderThickness="0"
                              RowHeight="38"
                              SelectionChanged="ObjectGrid_SelectionChanged"
                              MouseDoubleClick="ObjectGrid_MouseDoubleClick">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background"     Value="Transparent"/>
                                <Setter Property="BorderBrush"    Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="Height"         Value="32"/>
                                <Setter Property="Padding"        Value="0"/>
                                <Setter Property="Foreground"     Value="{DynamicResource TextMutedBrush}"/>
                                <Setter Property="FontSize"       Value="11"/>
                                <Setter Property="FontWeight"     Value="Medium"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridColumnHeader">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>

                            <!-- Checkbox -->
                            <DataGridTemplateColumn Width="44" MinWidth="44"
                                                    CanUserResize="False" CanUserSort="False">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Focusable="False"
                                                  IsChecked="{Binding DataContext.AreAllObjectsSelected,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid},
                                                      Mode=OneWay}"
                                                  PreviewMouseLeftButtonDown="ObjectSelectAll_PreviewMouseDown"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsSelected,
                                                      RelativeSource={RelativeSource AncestorType=DataGridRow},
                                                      Mode=OneWay}"
                                                  PreviewMouseLeftButtonDown="ObjectRowCheckBox_PreviewMouseDown"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Icon -->
                            <DataGridTemplateColumn Width="40" MinWidth="40"
                                                    CanUserResize="False" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text"       Value="&#xE8A5;"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                            <Setter Property="Text"       Value="&#xED41;"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Name -->
                            <DataGridTemplateColumn Header="Name" Width="*" MinWidth="120"
                                                    SortMemberPath="DisplayName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   Margin="4,0" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                            <Setter Property="FontWeight" Value="Medium"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Date modified -->
                            <DataGridTextColumn Header="Date modified"
                                                Binding="{Binding LastModified, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                                Width="130" MinWidth="110"
                                                SortMemberPath="LastModified">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="Padding" Value="6,0"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>

                            <!-- Type -->
                            <DataGridTextColumn Header="Type"
                                                Binding="{Binding FileType}"
                                                Width="110" MinWidth="80"
                                                SortMemberPath="FileType">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="Padding" Value="6,0"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>

                            <!-- Size -->
                            <DataGridTextColumn Header="Size"
                                                Binding="{Binding DisplaySize}"
                                                Width="80" MinWidth="60"
                                                SortMemberPath="SizeBytes">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="Padding" Value="6,0"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ── Object batch action bar ───────────────── -->
                    <Border Grid.Row="3"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,12,12"
                            Padding="10,8"
                            Visibility="{Binding HasObjectSelection, Converter={StaticResource BoolToVisible}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Count -->
                            <TextBlock Grid.Column="0" FontSize="11" FontWeight="Medium"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}">
                                <Run Text="{Binding SelectedObjectCount, Mode=OneWay}"/>
                                <Run Text="selected"/>
                            </TextBlock>

                            <!-- Actions -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}"
                                        Command="{Binding DownloadFileCommand}"
                                        Padding="10,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="Download" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <!-- Divider -->
                                <Border Width="1" Background="{DynamicResource BorderBrush}"
                                        Margin="6,4" VerticalAlignment="Stretch"/>
                                <!-- Clear -->
                                <Button Style="{StaticResource GhostButton}"
                                        Click="ObjectGrid_ClearSelection"
                                        Foreground="{DynamicResource TextMutedBrush}" Padding="8,5">
                                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Empty state — no bucket selected -->
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding SelectedBucket, Converter={StaticResource NullToVisible}}">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="40" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="Select a bucket to browse its contents"
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>

                </Grid>
            </Border>
        </Grid>

        <!-- Status / Progress bar -->
        <Border Grid.Row="2" Margin="32,12,32,24"
                Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVisible}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding UploadProgress, StringFormat=' {0}%'}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <ProgressBar Value="{Binding UploadProgress}" Maximum="100"/>
            </StackPanel>
        </Border>

        <!-- ════════════════════════════════════════════════════════ -->
        <!--  Create Bucket Modal                                    -->
        <!-- ════════════════════════════════════════════════════════ -->
        <Grid Grid.RowSpan="3"
              Visibility="{Binding IsCreateBucketOpen, Converter={StaticResource BoolToVisible}}"
              Background="#AA000000" Panel.ZIndex="100">
            <Grid.Resources>
                <!-- Option card style for radio-button cards -->
                <Style x:Key="OptionCard" TargetType="RadioButton">
                    <Setter Property="Cursor"          Value="Hand"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Bd" CornerRadius="8" Padding="14,12"
                                        BorderThickness="1.5"
                                        Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Custom radio dot -->
                                        <Grid Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0">
                                            <Ellipse x:Name="Ring" Stroke="{DynamicResource BorderBrush}"
                                                     StrokeThickness="1.5" Fill="Transparent"/>
                                            <Ellipse x:Name="Fill" Width="8" Height="8"
                                                     Fill="Transparent" HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                                        </Grid>
                                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd"   Property="BorderBrush"  Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="Bd"   Property="Background"   Value="{DynamicResource SidebarActiveBrush}"/>
                                        <Setter TargetName="Ring" Property="Stroke"       Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="Fill" Property="Fill"         Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.45"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>

            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="720" MaxHeight="860" CornerRadius="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ── Modal header ───────────────────────────── -->
                    <StackPanel Grid.Row="0" Margin="28,22,28,16">
                        <TextBlock Text="Create bucket" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Buckets are containers for data stored in S3."
                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Separator Grid.Row="0" VerticalAlignment="Bottom"
                               Background="{DynamicResource BorderBrush}" Height="1" Margin="0"/>

                    <!-- ── Scrollable form ────────────────────────── -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                        <StackPanel Margin="28,20,28,8"
                                    IsEnabled="{Binding IsCreatingBucket, Converter={StaticResource BoolInvert}}">

                            <!-- ┌──────────────────────────────────┐ -->
                            <!-- │  General configuration           │ -->
                            <!-- └──────────────────────────────────┘ -->
                            <TextBlock Text="General configuration" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                            <!-- AWS Region -->
                            <TextBlock Text="AWS Region" FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <ComboBox Margin="0,0,0,18" FontSize="13" Padding="10,8"
                                      ItemsSource="{Binding Source={x:Static vm:S3ViewModel.AwsRegions}}"
                                      SelectedValuePath="Code"
                                      SelectedValue="{Binding NewBucketRegion}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Label}" Margin="0,0,6,0"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Code}"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Bucket type -->
                            <TextBlock Text="Bucket type" FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                            <RadioButton Style="{StaticResource OptionCard}"
                                         GroupName="BucketType" Margin="0,0,0,8"
                                         IsChecked="{Binding NewBucketType,
                                             Converter={StaticResource EqualityToBool},
                                             ConverterParameter=GeneralPurpose}">
                                <StackPanel>
                                    <TextBlock Text="General purpose" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" Margin="0,3,0,0"
                                               Text="Recommended for most use cases. Stores objects redundantly across multiple Availability Zones."/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource OptionCard}"
                                         GroupName="BucketType" Margin="0,0,0,18"
                                         IsChecked="{Binding NewBucketType,
                                             Converter={StaticResource EqualityToBool},
                                             ConverterParameter=Directory}">
                                <StackPanel>
                                    <TextBlock Text="Directory" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" Margin="0,3,0,0"
                                               Text="Recommended for low-latency use cases. Uses S3 Express One Zone storage within a single Availability Zone."/>
                                </StackPanel>
                            </RadioButton>

                            <!-- Bucket namespace -->
                            <TextBlock Text="Bucket namespace" FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                            <RadioButton Style="{StaticResource OptionCard}"
                                         GroupName="BucketNamespace" Margin="0,0,0,8"
                                         IsChecked="{Binding NewBucketNamespace,
                                             Converter={StaticResource EqualityToBool},
                                             ConverterParameter=Global}">
                                <StackPanel>
                                    <TextBlock Text="Global namespace" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" Margin="0,3,0,0"
                                               Text="S3 creates general purpose buckets in the global namespace. Bucket names must be unique across all AWS accounts."/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource OptionCard}"
                                         GroupName="BucketNamespace" Margin="0,0,0,18"
                                         IsChecked="{Binding NewBucketNamespace,
                                             Converter={StaticResource EqualityToBool},
                                             ConverterParameter=AccountRegional}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Account Regional namespace" FontSize="13" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border Background="{DynamicResource SidebarActiveBrush}" CornerRadius="4"
                                                Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="recommended" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" Margin="0,3,0,0"
                                               Text="Bucket names are unique to your account. These buckets can never be created by another AWS account."/>
                                </StackPanel>
                            </RadioButton>

                            <!-- Bucket name -->
                            <TextBlock Text="Bucket name" FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding NewBucketName, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="13" Padding="10,8" Margin="0,0,0,4"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,4"
                                       Text="Bucket names must be 3–63 characters and unique within the namespace. Must begin and end with a letter or number. Valid characters: a–z, 0–9, periods (.), hyphens (-)."/>

                            <!-- ── Divider ── -->
                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,20,0,20"/>

                            <!-- ┌──────────────────────────────────┐ -->
                            <!-- │  Object Ownership                │ -->
                            <!-- └──────────────────────────────────┘ -->
                            <TextBlock Text="Object Ownership" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,14"
                                       Text="Control ownership of objects written to this bucket from other AWS accounts and the use of access control lists (ACLs)."/>

                            <RadioButton Style="{StaticResource OptionCard}"
                                         GroupName="ObjectOwnership" Margin="0,0,0,8"
                                         IsChecked="{Binding NewBucketAclsEnabled,
                                             Converter={StaticResource BoolInvert}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ACLs disabled" FontSize="13" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border Background="{DynamicResource SidebarActiveBrush}" CornerRadius="4"
                                                Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="recommended" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" Margin="0,3,0,0"
                                               Text="All objects in this bucket are owned by this account. Access is specified using only policies."/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource OptionCard}"
                                         GroupName="ObjectOwnership" Margin="0,0,0,4"
                                         IsChecked="{Binding NewBucketAclsEnabled}">
                                <StackPanel>
                                    <TextBlock Text="ACLs enabled" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" Margin="0,3,0,0"
                                               Text="Objects in this bucket can be owned by other AWS accounts. Access can be specified using ACLs."/>
                                </StackPanel>
                            </RadioButton>

                            <!-- ── Divider ── -->
                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,20,0,20"/>

                            <!-- ┌──────────────────────────────────┐ -->
                            <!-- │  Block Public Access             │ -->
                            <!-- └──────────────────────────────────┘ -->
                            <TextBlock Text="Block Public Access settings for this bucket"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,14"
                                       Text="Public access is granted to buckets and objects through ACLs, bucket policies, or access point policies. AWS recommends that you turn on Block all public access."/>

                            <!-- Master toggle -->
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="14,12" Margin="0,0,0,8"
                                    Background="{DynamicResource BackgroundBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding NewBucketBlockAll}"
                                              VerticalAlignment="Top" Margin="0,2,10,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Block all public access" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="Turning this setting on is the same as turning on all four settings below. Each of the following settings are independent of one another."/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Sub checkboxes -->
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="14,12"
                                    Background="{DynamicResource BackgroundBrush}">
                                <StackPanel>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding NewBucketBlockPublicAclNew}"
                                                  VerticalAlignment="Top" Margin="0,2,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontSize="12" FontWeight="Medium" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Text="Block public access to buckets and objects granted through new access control lists (ACLs)"/>
                                            <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Text="S3 will block public access permissions applied to newly added buckets or objects, and prevent the creation of new public access ACLs for existing buckets and objects. This setting doesn't change any existing permissions that allow public access to S3 resources using ACLs."/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding NewBucketBlockPublicAclAny}"
                                                  VerticalAlignment="Top" Margin="0,2,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontSize="12" FontWeight="Medium" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Text="Block public access to buckets and objects granted through any access control lists (ACLs)"/>
                                            <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Text="S3 will ignore all ACLs that grant public access to buckets and objects."/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding NewBucketBlockPublicPolicyNew}"
                                                  VerticalAlignment="Top" Margin="0,2,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontSize="12" FontWeight="Medium" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Text="Block public access to buckets and objects granted through new public bucket or access point policies"/>
                                            <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Text="S3 will block new bucket and access point policies that grant public access to buckets and objects. This setting doesn't change any existing policies that allow public access to S3 resources."/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding NewBucketBlockPublicPolicyCrossAcct}"
                                                  VerticalAlignment="Top" Margin="0,2,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontSize="12" FontWeight="Medium" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Text="Block public and cross-account access to buckets and objects through any public bucket or access point policies"/>
                                            <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Text="S3 will ignore public and cross-account access for buckets or access points with policies that grant public access."/>
                                        </StackPanel>
                                    </Grid>

                                </StackPanel>
                            </Border>

                            <!-- ── Divider ── -->
                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,20,0,20"/>

                            <!-- ┌──────────────────────────────────┐ -->
                            <!-- │  Bucket Versioning               │ -->
                            <!-- └──────────────────────────────────┘ -->
                            <TextBlock Text="Bucket Versioning" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,14"
                                       Text="Versioning is a means of keeping multiple variants of an object in the same bucket. You can use versioning to preserve, retrieve, and restore every version of every object stored in your S3 bucket."/>

                            <RadioButton Style="{StaticResource OptionCard}"
                                         GroupName="Versioning" Margin="0,0,0,8"
                                         IsChecked="{Binding NewBucketVersioningEnabled,
                                             Converter={StaticResource BoolInvert}}">
                                <TextBlock Text="Disable" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </RadioButton>
                            <RadioButton Style="{StaticResource OptionCard}"
                                         GroupName="Versioning" Margin="0,0,0,4"
                                         IsChecked="{Binding NewBucketVersioningEnabled}">
                                <TextBlock Text="Enable" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </RadioButton>

                            <!-- ── Divider ── -->
                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,20,0,20"/>

                            <!-- ┌──────────────────────────────────┐ -->
                            <!-- │  Tags                            │ -->
                            <!-- └──────────────────────────────────┘ -->
                            <TextBlock Text="Tags - optional" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="You can use bucket tags to analyze, manage and specify permissions for a bucket."/>

                            <!-- Tag column headers (visible when list is non-empty) -->
                            <Grid Visibility="{Binding NewBucketTags.Count, Converter={StaticResource ZeroToCollapsed}}"
                                  Margin="0,0,36,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Key" FontSize="11" FontWeight="Medium"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="2" Text="Value" FontSize="11" FontWeight="Medium"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </Grid>

                            <!-- Tag list -->
                            <ItemsControl ItemsSource="{Binding NewBucketTags}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="36"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="12" Padding="8,6"/>
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="12" Padding="8,6"/>
                                            <Button Grid.Column="3" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource GhostButton}"
                                                    Command="{Binding DataContext.RemoveTagCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="6,4" ToolTip="Remove tag">
                                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="11" Foreground="{DynamicResource DangerBrush}"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Style="{StaticResource GhostButton}"
                                    Command="{Binding AddTagCommand}"
                                    HorizontalAlignment="Left" Padding="0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Add new tag" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="You can add up to 50 tags." FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>

                            <!-- ── Divider ── -->
                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,20,0,20"/>

                            <!-- ┌──────────────────────────────────┐ -->
                            <!-- │  Default Encryption              │ -->
                            <!-- └──────────────────────────────────┘ -->
                            <TextBlock Text="Default encryption" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,14"
                                       Text="Server-side encryption is automatically applied to new objects stored in this bucket."/>

                            <TextBlock Text="Encryption type" FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                            <RadioButton Style="{StaticResource OptionCard}"
                                         GroupName="Encryption" Margin="0,0,0,8"
                                         IsChecked="{Binding NewBucketEncryption,
                                             Converter={StaticResource EqualityToBool},
                                             ConverterParameter=SSE_S3}">
                                <StackPanel>
                                    <TextBlock Text="SSE-S3" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Server-side encryption with Amazon S3 managed keys"
                                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource OptionCard}"
                                         GroupName="Encryption" Margin="0,0,0,8"
                                         IsChecked="{Binding NewBucketEncryption,
                                             Converter={StaticResource EqualityToBool},
                                             ConverterParameter=SSE_KMS}">
                                <StackPanel>
                                    <TextBlock Text="SSE-KMS" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Server-side encryption with AWS Key Management Service keys"
                                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource OptionCard}"
                                         GroupName="Encryption" Margin="0,0,0,18"
                                         IsChecked="{Binding NewBucketEncryption,
                                             Converter={StaticResource EqualityToBool},
                                             ConverterParameter=DSSE_KMS}">
                                <StackPanel>
                                    <TextBlock Text="DSSE-KMS" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Dual-layer server-side encryption with AWS Key Management Service keys"
                                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- Bucket Key (only relevant for SSE-KMS) -->
                            <TextBlock Text="Bucket Key" FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="Using an S3 Bucket Key for SSE-KMS reduces encryption costs by lowering calls to AWS KMS. S3 Bucket Keys aren't supported for DSSE-KMS."/>
                            <RadioButton Style="{StaticResource OptionCard}"
                                         GroupName="BucketKey" Margin="0,0,0,8"
                                         IsChecked="{Binding NewBucketKeyEnabled,
                                             Converter={StaticResource BoolInvert}}">
                                <TextBlock Text="Disable" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </RadioButton>
                            <RadioButton Style="{StaticResource OptionCard}"
                                         GroupName="BucketKey" Margin="0,0,0,4"
                                         IsChecked="{Binding NewBucketKeyEnabled}">
                                <TextBlock Text="Enable" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </RadioButton>

                            <!-- ── Divider ── -->
                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,20,0,16"/>

                            <!-- Advanced settings note -->
                            <TextBlock Text="Advanced settings" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="After creating the bucket, you can upload files and folders to the bucket, and configure additional bucket settings."/>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- ── Footer ─────────────────────────────────── -->
                    <Border Grid.Row="2" BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource BorderBrush}" Padding="28,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Error -->
                            <TextBlock Grid.Column="0"
                                       Text="{Binding ErrorMessage}"
                                       FontSize="12" Foreground="{DynamicResource DangerBrush}"
                                       TextWrapping="Wrap" VerticalAlignment="Center"
                                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}"/>

                            <!-- Buttons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource GhostButton}"
                                        Command="{Binding CancelCreateBucketCommand}"
                                        Content="Cancel" Margin="0,0,10,0"
                                        IsEnabled="{Binding IsCreatingBucket, Converter={StaticResource BoolInvert}}"/>
                                <Button Style="{StaticResource PrimaryButton}"
                                        Command="{Binding CreateBucketCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Creating…" VerticalAlignment="Center"
                                                   Visibility="{Binding IsCreatingBucket, Converter={StaticResource BoolToVisible}}"/>
                                        <TextBlock Text="Create bucket" VerticalAlignment="Center"
                                                   Visibility="{Binding IsCreatingBucket, Converter={StaticResource BoolToInvisible}}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
