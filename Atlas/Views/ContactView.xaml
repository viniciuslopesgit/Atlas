<UserControl x:Class="Atlas.Views.ContactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Background="{DynamicResource BackgroundBrush}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32" MaxWidth="680" HorizontalAlignment="Left">

            <!-- Header -->
            <StackPanel Margin="0,0,0,6">
                <TextBlock Text="Contact &amp; Feedback" FontSize="24" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Report a bug, send a suggestion, or get in touch with the development team."
                           FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Divider -->
            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,20,0,24"/>

            <!-- Success state -->
            <Border CornerRadius="12" Padding="20,16" Margin="0,0,0,24"
                    Background="#12228B22"
                    BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1"
                    Visibility="{Binding IsSent, Converter={StaticResource BoolToVisible}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                               FontSize="16" Foreground="{DynamicResource SuccessBrush}"
                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Email client opened successfully!"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Command="{Binding ResetCommand}"
                            Style="{StaticResource GhostButton}"
                            Padding="10,6" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="Send another" FontSize="12.5"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Form card -->
            <Border Style="{StaticResource Card}"
                    Visibility="{Binding IsSent, Converter={StaticResource BoolToInvisible}}">
                <StackPanel>

                    <!-- Type selector -->
                    <TextBlock Text="TYPE" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding FeedbackTypes}"
                              SelectedItem="{Binding SelectedType}"
                              Height="38" FontSize="13"
                              Background="{DynamicResource BackgroundBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              Margin="0,0,0,20"/>

                    <!-- Subject -->
                    <TextBlock Text="SUBJECT" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}"
                             Height="38" FontSize="13" Padding="12,8"
                             Background="{DynamicResource BackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                             Margin="0,0,0,20"/>

                    <!-- Description -->
                    <TextBlock Text="DESCRIPTION" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             Height="140" FontSize="13" Padding="12,10"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource BackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                             VerticalContentAlignment="Top"
                             Margin="0,0,0,8"/>

                    <TextBlock Text="Your default email client will open with a pre-filled message."
                               FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,0,20"/>

                    <!-- Error banner -->
                    <Border CornerRadius="8" Padding="12,10" Margin="0,0,0,16"
                            Background="#26EF4444"
                            BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisible}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA39;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource DangerBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Send button -->
                    <Button Command="{Binding SendCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Height="42" HorizontalAlignment="Left"
                            MinWidth="180">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock Text="Open Email Client" FontSize="13.5" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
