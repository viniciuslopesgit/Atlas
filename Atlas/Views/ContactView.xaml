<UserControl x:Class="Atlas.Views.ContactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Background="{DynamicResource BackgroundBrush}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32" MaxWidth="680" HorizontalAlignment="Left">

            <!-- Header -->
            <StackPanel Margin="0,0,0,6">
                <TextBlock Text="Contact &amp; Feedback" FontSize="24" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Report a bug, send a suggestion, or get in touch with the development team."
                           FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,20,0,24"/>

            <!-- Success state -->
            <Border CornerRadius="12" Padding="20,16" Margin="0,0,0,24"
                    Background="#12228B22"
                    BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1"
                    Visibility="{Binding IsSent, Converter={StaticResource BoolToVisible}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                               FontSize="18" Foreground="{DynamicResource SuccessBrush}"
                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Feedback sent successfully!"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Command="{Binding ResetCommand}"
                            Style="{StaticResource GhostButton}"
                            Padding="10,6" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="Send another" FontSize="12"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Form card -->
            <Border Style="{StaticResource Card}"
                    Visibility="{Binding IsSent, Converter={StaticResource BoolToInvisible}}">
                <StackPanel>

                    <!-- Type -->
                    <TextBlock Text="Type" FontSize="12" FontWeight="Medium"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding FeedbackTypes}"
                              SelectedItem="{Binding SelectedType}"
                              Height="34" FontSize="13"
                              Margin="0,0,0,16"/>

                    <!-- Subject -->
                    <TextBlock Text="Subject" FontSize="12" FontWeight="Medium"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <Border Style="{StaticResource InputBorder}" Height="34" Margin="0,0,0,16">
                        <TextBox Style="{x:Null}"
                                 Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontSize="13" Padding="11,0"
                                 VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                 CaretBrush="{DynamicResource AccentBrush}"/>
                    </Border>

                    <!-- Description -->
                    <TextBlock Text="Description" FontSize="12" FontWeight="Medium"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <Border Style="{StaticResource InputBorder}" Height="140" Margin="0,0,0,6">
                        <TextBox Style="{x:Null}"
                                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontSize="13" Padding="11,9"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                                 CaretBrush="{DynamicResource AccentBrush}"/>
                    </Border>
                    <TextBlock Text="Your message will be sent directly — no email client required."
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,18"/>

                    <!-- Error banner -->
                    <Border CornerRadius="8" Padding="12,10" Margin="0,0,0,14"
                            Background="#26EF4444"
                            BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisible}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA39;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource DangerBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="13" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Send button -->
                    <Button Command="{Binding SendCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Height="38" HorizontalAlignment="Left" Padding="18,0"
                            IsEnabled="{Binding SendCommand.IsRunning, Converter={StaticResource BoolInvert}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Visibility="{Binding SendCommand.IsRunning, Converter={StaticResource BoolToVisible}}"/>
                            <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Visibility="{Binding SendCommand.IsRunning, Converter={StaticResource BoolToInvisible}}"/>
                            <TextBlock FontSize="13" FontWeight="Medium" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Send Feedback"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SendCommand.IsRunning}" Value="True">
                                                <Setter Property="Text" Value="Sending…"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
