<Window x:Class="Atlas.Views.CreateUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" Background="{DynamicResource SurfaceBrush}"
        ResizeMode="NoResize" Width="600" Height="700"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>

        <Style x:Key="FormRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Ring" Width="16" Height="16" CornerRadius="8"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                                    Background="Transparent" Margin="0,0,10,0" SnapsToDevicePixels="True">
                                <Border x:Name="Dot" Width="8" Height="8" CornerRadius="4" Background="Transparent"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Dot"  Property="Background"  Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormCheck" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <BulletDecorator Background="Transparent" SnapsToDevicePixels="True">
                            <BulletDecorator.Bullet>
                                <Border x:Name="checkBorder" Width="16" Height="16" CornerRadius="4"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                                        Background="Transparent">
                                    <TextBlock x:Name="checkMark" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="White" Visibility="Collapsed"/>
                                </Border>
                            </BulletDecorator.Bullet>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkBorder" Property="Background"   Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="checkBorder" Property="BorderBrush"  Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="checkMark"   Property="Visibility"   Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SectionDiv" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Margin" Value="0,18,0,18"/>
        </Style>

        <!-- Permission option card -->
        <Style x:Key="PermCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource BackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                                CornerRadius="10" Padding="14,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border x:Name="Ring" Width="16" Height="16" CornerRadius="8"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                                            Background="Transparent" Margin="0,0,8,0" SnapsToDevicePixels="True">
                                        <Border x:Name="Dot" Width="8" Height="8" CornerRadius="4" Background="Transparent"/>
                                    </Border>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="Desc" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap" Tag="{TemplateBinding Tag}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd"   Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Dot"  Property="Background"  Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="14" Padding="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Header ─────────────────────────────────────────────── -->
            <Border Grid.Row="0" x:Name="DragHandle" Padding="24,20,20,18"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="DragHandle_MouseDown" Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="10" Margin="0,0,14,0">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource AccentColor}" Opacity="0.15"/>
                            </Border.Background>
                            <TextBlock Text="&#xE8FA;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Create IAM User" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="StepBadge" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Click="Cancel_Click" Style="{StaticResource GhostButton}"
                            Padding="8" VerticalAlignment="Top">
                        <TextBlock Text="✕" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ── Body ───────────────────────────────────────────────── -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Step indicator -->
                    <Border Grid.Row="0" Padding="24,18,24,16"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Step 1 -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <Border x:Name="Circle1" Width="28" Height="28" CornerRadius="14"
                                        HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <TextBlock x:Name="CircleText1" Text="1" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="StepLabel1" Text="User details" FontSize="11"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Line 1 -->
                            <Border x:Name="StepLine1" Grid.Column="1" Height="1.5"
                                    VerticalAlignment="Top" Margin="4,14,4,0"/>

                            <!-- Step 2 -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <Border x:Name="Circle2" Width="28" Height="28" CornerRadius="14"
                                        HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <TextBlock x:Name="CircleText2" Text="2" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="StepLabel2" Text="Set permissions" FontSize="11"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Line 2 -->
                            <Border x:Name="StepLine2" Grid.Column="3" Height="1.5"
                                    VerticalAlignment="Top" Margin="4,14,4,0"/>

                            <!-- Step 3 -->
                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                <Border x:Name="Circle3" Width="28" Height="28" CornerRadius="14"
                                        HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <TextBlock x:Name="CircleText3" Text="3" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="StepLabel3" Text="Review and create" FontSize="11"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ══ Step content ══ -->
                    <Grid Grid.Row="1">

                        <!-- ══ STEP 1: User details ══ -->
                        <StackPanel x:Name="Step1Panel" Margin="24,18,24,12" Visibility="Visible">

                            <TextBlock Text="User name" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputBorder}" Height="34">
                                <TextBox x:Name="TxtUserName" Style="{x:Null}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         FontSize="13" Padding="11,0"
                                         VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                         CaretBrush="{DynamicResource AccentBrush}"
                                         SelectionBrush="{DynamicResource AccentBrush}"
                                         TextChanged="TxtUserName_Changed"/>
                            </Border>
                            <TextBlock x:Name="TxtNameError" Foreground="{DynamicResource DangerBrush}"
                                       FontSize="11" Margin="0,4,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="Up to 64 characters · Valid: A-Z, a-z, 0-9, + = , . @ _ - (hyphen)"/>

                            <Border Style="{StaticResource SectionDiv}"/>

                            <!-- Console access -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <CheckBox x:Name="ChkConsoleAccess" Style="{StaticResource FormCheck}"
                                          Checked="ConsoleAccess_Changed" Unchecked="ConsoleAccess_Changed"/>
                                <StackPanel Margin="0,0,0,0">
                                    <TextBlock Text="Provide user access to the AWS Management Console"
                                               FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="User can sign in to the AWS console with a username and password."
                                               Margin="0,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Console password panel -->
                            <Border x:Name="PnlConsoleAccess" Visibility="Collapsed"
                                    Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16,14" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Console password" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>

                                    <RadioButton x:Name="RdoAutoPass" GroupName="PasswordType"
                                                 Style="{StaticResource FormRadio}" IsChecked="True"
                                                 Checked="PasswordType_Changed" Content="Autogenerated password"
                                                 Margin="0,0,0,6"/>
                                    <RadioButton x:Name="RdoCustomPass" GroupName="PasswordType"
                                                 Style="{StaticResource FormRadio}"
                                                 Checked="PasswordType_Changed" Content="Custom password"/>

                                    <!-- Custom password field -->
                                    <StackPanel x:Name="PnlCustomPass" Visibility="Collapsed" Margin="0,10,0,0">
                                        <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource InputBorder}" Height="34">
                                                <PasswordBox x:Name="TxtPassword" Style="{x:Null}"
                                                             Background="Transparent" BorderThickness="0"
                                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                                             FontSize="13" Padding="11,0"
                                                             VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                                             CaretBrush="{DynamicResource AccentBrush}"
                                                             PasswordChanged="TxtPassword_Changed"/>
                                            </Border>
                                            <Button Grid.Column="1" x:Name="BtnReveal"
                                                    Style="{StaticResource GhostButton}" Padding="10,0"
                                                    Click="Reveal_Click" ToolTip="Show / hide">
                                                <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </Button>
                                            <Border Grid.Column="0" Style="{StaticResource InputBorder}" Height="34"
                                                    Visibility="Collapsed" x:Name="TxtPasswordVisibleBorder">
                                                <TextBox x:Name="TxtPasswordVisible" Style="{x:Null}"
                                                         Background="Transparent" BorderThickness="0"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                                         FontSize="13" Padding="11,0"
                                                         VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                                         CaretBrush="{DynamicResource AccentBrush}"
                                                         TextChanged="PasswordVisible_Changed"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Autogenerated preview -->
                                    <StackPanel x:Name="PnlAutoPass" Margin="0,10,0,0">
                                        <TextBlock Text="Generated password" Style="{StaticResource FieldLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource InputBorder}" Height="34">
                                                <TextBox x:Name="TxtGeneratedPass" Style="{x:Null}"
                                                         Background="Transparent" BorderThickness="0"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                                         IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                                         Padding="11,0" VerticalAlignment="Stretch" VerticalContentAlignment="Center"/>
                                            </Border>
                                            <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                                                    Padding="10,0" Click="CopyPassword_Click" ToolTip="Copy to clipboard">
                                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="Save this password — it will not be shown again."
                                                   Style="{StaticResource HintText}" Foreground="{DynamicResource DangerBrush}"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>

                                    <Border Style="{StaticResource SectionDiv}" Margin="0,14,0,14"/>

                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="ChkPasswordReset" Style="{StaticResource FormCheck}"
                                                  IsChecked="True"/>
                                        <TextBlock Text="Users must create a new password at next sign-in"
                                                   FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Margin="0,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- ══ STEP 2: Set permissions ══ -->
                        <StackPanel x:Name="Step2Panel" Margin="24,18,24,12" Visibility="Collapsed">

                            <TextBlock Text="Permissions options" Style="{StaticResource SectionHeader}"/>

                            <!-- 3 option cards -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <RadioButton Grid.Column="0" x:Name="RdoAddToGroup"
                                             Style="{StaticResource PermCard}" GroupName="PermMode"
                                             IsChecked="True" Checked="PermMode_Changed">
                                    <TextBlock Text="Add user to a group" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </RadioButton>

                                <RadioButton Grid.Column="2" x:Name="RdoCopyPerms"
                                             Style="{StaticResource PermCard}" GroupName="PermMode"
                                             Checked="PermMode_Changed">
                                    <TextBlock Text="Copy permissions" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </RadioButton>

                                <RadioButton Grid.Column="4" x:Name="RdoAttachPolicies"
                                             Style="{StaticResource PermCard}" GroupName="PermMode"
                                             Checked="PermMode_Changed">
                                    <TextBlock Text="Attach policies directly" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </RadioButton>
                            </Grid>

                            <!-- Add to group panel -->
                            <StackPanel x:Name="PnlGroups" Visibility="Visible">
                                <TextBlock Text="Available groups" Style="{StaticResource FieldLabel}"/>
                                <Border Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" MaxHeight="260">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="GroupsList" Margin="4,4,4,4"/>
                                    </ScrollViewer>
                                </Border>
                                <TextBlock x:Name="TxtNoGroups" Text="No groups available. Create a group first."
                                           Style="{StaticResource HintText}" Visibility="Collapsed"/>
                            </StackPanel>

                            <!-- Copy permissions panel -->
                            <StackPanel x:Name="PnlCopyPerms" Visibility="Collapsed">
                                <TextBlock Text="Copy permissions from existing user" Style="{StaticResource FieldLabel}"/>
                                <Border Style="{StaticResource InputBorder}" Height="34">
                                    <TextBox x:Name="TxtCopyFrom" Style="{x:Null}"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             FontSize="13" Padding="11,0"
                                             VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                             CaretBrush="{DynamicResource AccentBrush}"
                                             ToolTip="Enter the exact IAM username to copy from"/>
                                </Border>
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="Copies group memberships and attached managed policies from that user."/>
                            </StackPanel>

                            <!-- Attach policies panel -->
                            <StackPanel x:Name="PnlAttachPolicies" Visibility="Collapsed">
                                <TextBlock Text="Available policies" Style="{StaticResource FieldLabel}"/>
                                <Border Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" MaxHeight="240">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="PoliciesList" Margin="4,4,4,4"/>
                                    </ScrollViewer>
                                </Border>
                                <TextBlock x:Name="TxtNoPolicies" Text="No local policies available."
                                           Style="{StaticResource HintText}" Visibility="Collapsed"/>
                                <TextBlock Text="Only customer-managed policies are shown. To use an AWS managed policy, enter its ARN below."
                                           Style="{StaticResource HintText}" Margin="0,6,0,6"/>
                                <Border Style="{StaticResource InputBorder}" Height="34">
                                    <TextBox x:Name="TxtExtraArn" Style="{x:Null}"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             FontSize="13" Padding="11,0"
                                             VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                             CaretBrush="{DynamicResource AccentBrush}"
                                             ToolTip="Optional: additional policy ARN"/>
                                </Border>
                            </StackPanel>

                        </StackPanel>

                        <!-- ══ STEP 3: Review ══ -->
                        <StackPanel x:Name="Step3Panel" Margin="24,18,24,12" Visibility="Collapsed">

                            <TextBlock Text="Review and create" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="Review the details below. After creating, you can manage permissions and credentials in the user detail view."
                                       Style="{StaticResource HintText}" Margin="0,0,0,16"/>

                            <!-- User details card -->
                            <Border Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="18,14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="User details" Style="{StaticResource SectionHeader}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="User name" FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                            <TextBlock x:Name="ReviewUserName" FontSize="13"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Console password type" FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                            <TextBlock x:Name="ReviewConsoleType" FontSize="13"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Require password reset" FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                            <TextBlock x:Name="ReviewPasswordReset" FontSize="13"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Permissions card -->
                            <Border Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="18,14">
                                <StackPanel>
                                    <TextBlock Text="Permissions summary" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock x:Name="ReviewPermType" FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                                    <ItemsControl x:Name="ReviewPermList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SidebarActiveBrush}"
                                                        CornerRadius="4" Padding="8,4" Margin="0,2">
                                                    <TextBlock Text="{Binding}" FontSize="12"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="ReviewPermNone" Text="No permissions assigned."
                                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                    </Grid><!-- end step content -->
                </Grid>
            </ScrollViewer>

            <!-- ── Footer ─────────────────────────────────────────────── -->
            <Grid Grid.Row="2">
                <Border Height="1" Background="{DynamicResource BorderBrush}" VerticalAlignment="Top"/>
                <Grid Margin="20,12,20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnBack" Grid.Column="0" Style="{StaticResource GhostButton}"
                            Click="Back_Click" Padding="16,8" Visibility="Collapsed">
                        <TextBlock Text="Back" FontSize="13"/>
                    </Button>

                    <Button Grid.Column="2" Style="{StaticResource GhostButton}"
                            Click="Cancel_Click" Padding="16,8" Margin="0,0,8,0">
                        <TextBlock Text="Cancel" FontSize="13"/>
                    </Button>

                    <Button x:Name="BtnNext" Grid.Column="3" Click="Next_Click" Padding="16,8">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{DynamicResource AccentBrush}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock x:Name="BtnNextText" Text="Next" FontSize="13"
                                   FontWeight="Medium" Foreground="White"/>
                    </Button>

                </Grid>
            </Grid>

        </Grid>
    </Border>
</Window>
