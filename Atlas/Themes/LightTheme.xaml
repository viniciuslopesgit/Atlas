<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Core Colours ─────────────────────────────────────────── -->
    <Color x:Key="BackgroundColor">#FFF5F5F5</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="SidebarColor">#FFFFFFFF</Color>
    <Color x:Key="BorderColor">#FFE8E8E8</Color>
    <Color x:Key="AccentColor">#FF2563EB</Color>
    <Color x:Key="AccentHoverColor">#FF1D4ED8</Color>
    <Color x:Key="TextPrimaryColor">#FF191919</Color>
    <Color x:Key="TextSecondaryColor">#FF6B6B6B</Color>
    <Color x:Key="TextMutedColor">#FFA3A3A3</Color>
    <Color x:Key="SuccessColor">#FF16A34A</Color>
    <Color x:Key="WarningColor">#FFD97706</Color>
    <Color x:Key="DangerColor">#FFDC2626</Color>
    <Color x:Key="SidebarActiveColor">#FFF3F4F6</Color>
    <Color x:Key="ShadowColor">#FF9CA3AF</Color>

    <!-- ── Brushes ───────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BackgroundBrush"    Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"       Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SidebarBrush"       Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="BorderBrush"        Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="AccentBrush"        Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"     Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="SuccessBrush"       Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush"       Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush"        Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="SidebarActiveBrush"      Color="{StaticResource SidebarActiveColor}"/>
    <SolidColorBrush x:Key="RowSelectedBrush"        Color="#DBEAFE"/>
    <SolidColorBrush x:Key="RowSelectedHoverBrush"   Color="#BFDBFE"/>

    <sys:String x:Key="ThemeName" xmlns:sys="clr-namespace:System;assembly=mscorlib">Light</sys:String>
    <sys:String x:Key="ThemeIcon" xmlns:sys="clr-namespace:System;assembly=mscorlib">🌙</sys:String>

</ResourceDictionary>
