<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Core Colours ─────────────────────────────────────────── -->
    <Color x:Key="BackgroundColor">#FF0C0C0C</Color>
    <Color x:Key="SurfaceColor">#FF161616</Color>
    <Color x:Key="SidebarColor">#FF111111</Color>
    <Color x:Key="BorderColor">#FF242424</Color>
    <Color x:Key="AccentColor">#FF3B82F6</Color>
    <Color x:Key="AccentHoverColor">#FF60A5FA</Color>
    <Color x:Key="TextPrimaryColor">#FFEBEBEB</Color>
    <Color x:Key="TextSecondaryColor">#FF8A8A8A</Color>
    <Color x:Key="TextMutedColor">#FF525252</Color>
    <Color x:Key="SuccessColor">#FF4ADE80</Color>
    <Color x:Key="WarningColor">#FFFBBF24</Color>
    <Color x:Key="DangerColor">#FFF87171</Color>
    <Color x:Key="SidebarActiveColor">#FF1C1C1C</Color>
    <Color x:Key="ShadowColor">#FF000000</Color>

    <!-- ── Brushes ───────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BackgroundBrush"    Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"       Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SidebarBrush"       Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="BorderBrush"        Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="AccentBrush"        Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"     Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="SuccessBrush"       Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush"       Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush"        Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="SidebarActiveBrush"      Color="{StaticResource SidebarActiveColor}"/>
    <SolidColorBrush x:Key="RowSelectedBrush"        Color="#1F2B4A"/>
    <SolidColorBrush x:Key="RowSelectedHoverBrush"   Color="#243356"/>

    <sys:String x:Key="ThemeName" xmlns:sys="clr-namespace:System;assembly=mscorlib">Dark</sys:String>
    <sys:String x:Key="ThemeIcon" xmlns:sys="clr-namespace:System;assembly=mscorlib">☀</sys:String>

</ResourceDictionary>
