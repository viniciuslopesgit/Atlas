<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Atlas</AssemblyName>
    <RootNamespace>Atlas</RootNamespace>
    <Platforms>x64</Platforms>
    <Version>0.0.26</Version>
    <StartupObject>Atlas.Program</StartupObject>
    <ApplicationIcon>icon\atlas.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="icon\unnamed.png"/>
    <Resource Include="icon\atlas.ico"/>
  </ItemGroup>

  <ItemGroup>
    <!-- AWS SDK -->
    <PackageReference Include="AWSSDK.Core" Version="3.7.*" />
    <PackageReference Include="AWSSDK.EC2" Version="3.7.*" />
    <PackageReference Include="AWSSDK.S3" Version="3.7.*" />
    <PackageReference Include="AWSSDK.CloudWatch" Version="3.7.*" />
    <PackageReference Include="AWSSDK.GuardDuty" Version="3.7.*" />
    <PackageReference Include="AWSSDK.CostExplorer" Version="3.7.*" />
    <PackageReference Include="AWSSDK.SecurityToken" Version="3.7.*" />
    <PackageReference Include="AWSSDK.IdentityManagement" Version="3.7.*" />
    <PackageReference Include="AWSSDK.SimpleSystemsManagement" Version="3.7.*" />

    <!-- Embedded terminal -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />

    <!-- DI + Logging -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.*" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.*" />

    <!-- SQLite -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.*" />

    <!-- MVVM Toolkit -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.*" />

    <!-- Data Protection (credential encryption) -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="9.0.*" />

    <!-- Auto-update -->
    <PackageReference Include="Velopack" Version="1.*" />

    <!-- Email -->
    <PackageReference Include="MailKit" Version="4.*" />

  </ItemGroup>

</Project>
