<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Atlas</AssemblyName>
    <RootNamespace>Atlas</RootNamespace>
    <Platforms>x64</Platforms>
    <Version>0.0.31</Version>
    <StartupObject>Atlas.Program</StartupObject>
    <ApplicationIcon>icon\atlas.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="icon\unnamed.png"/>
    <Resource Include="icon\atlas.ico"/>
  </ItemGroup>

  <ItemGroup>
    <!-- AWS SDK — Core -->
    <PackageReference Include="AWSSDK.Core" Version="3.7.*" />
    <PackageReference Include="AWSSDK.SecurityToken" Version="3.7.*" />
    <!-- Compute -->
    <PackageReference Include="AWSSDK.EC2" Version="3.7.*" />
    <PackageReference Include="AWSSDK.AutoScaling" Version="3.7.*" />
    <PackageReference Include="AWSSDK.Lambda" Version="3.7.*" />
    <!-- Containers -->
    <PackageReference Include="AWSSDK.ECS" Version="3.7.*" />
    <PackageReference Include="AWSSDK.ECR" Version="3.7.*" />
    <PackageReference Include="AWSSDK.EKS" Version="3.7.*" />
    <!-- Storage -->
    <PackageReference Include="AWSSDK.S3" Version="3.7.*" />
    <!-- Database -->
    <PackageReference Include="AWSSDK.RDS" Version="3.7.*" />
    <PackageReference Include="AWSSDK.DynamoDBv2" Version="3.7.*" />
    <PackageReference Include="AWSSDK.ElastiCache" Version="3.7.*" />
    <!-- Networking -->
    <PackageReference Include="AWSSDK.ElasticLoadBalancingV2" Version="3.7.*" />
    <PackageReference Include="AWSSDK.Route53" Version="3.7.*" />
    <!-- Messaging -->
    <PackageReference Include="AWSSDK.SQS" Version="3.7.*" />
    <PackageReference Include="AWSSDK.SimpleNotificationService" Version="3.7.*" />
    <!-- Serverless -->
    <PackageReference Include="AWSSDK.APIGateway" Version="3.7.*" />
    <!-- Security -->
    <PackageReference Include="AWSSDK.KeyManagementService" Version="3.7.*" />
    <PackageReference Include="AWSSDK.SecretsManager" Version="3.7.*" />
    <PackageReference Include="AWSSDK.CertificateManager" Version="3.7.*" />
    <!-- Monitoring -->
    <PackageReference Include="AWSSDK.CloudWatch" Version="3.7.*" />
    <PackageReference Include="AWSSDK.CloudWatchLogs" Version="3.7.*" />
    <!-- IAM + SSM -->
    <PackageReference Include="AWSSDK.IdentityManagement" Version="3.7.*" />
    <PackageReference Include="AWSSDK.SimpleSystemsManagement" Version="3.7.*" />
    <!-- Other -->
    <PackageReference Include="AWSSDK.GuardDuty" Version="3.7.*" />
    <PackageReference Include="AWSSDK.CostExplorer" Version="3.7.*" />

    <!-- Embedded terminal -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />

    <!-- DI + Logging -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.*" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.*" />

    <!-- SQLite -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.*" />

    <!-- MVVM Toolkit -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.*" />

    <!-- Data Protection (credential encryption) -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="9.0.*" />

    <!-- Auto-update -->
    <PackageReference Include="Velopack" Version="1.*" />

    <!-- Email -->
    <PackageReference Include="MailKit" Version="4.*" />

    <!-- HCL template engine -->
    <PackageReference Include="Scriban" Version="7.2.4" />

    <!-- CRON expression parser (drift schedule) -->
    <PackageReference Include="Cronos" Version="0.8.*" />

  </ItemGroup>

  <!-- Terraform HCL templates — embedded in the assembly so nenhum ficheiro externo é necessário -->
  <ItemGroup>
    <EmbeddedResource Include="Templates\Terraform\**\*.tpl" />
  </ItemGroup>

</Project>
