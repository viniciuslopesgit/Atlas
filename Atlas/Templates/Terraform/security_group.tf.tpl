{{- for cidr in rule.cidr_blocks }}
      "{{ cidr }}",
{{- end }}
    ]
  }
{{- end }}

  tags = {
    Name      = "{{ sg_name }}"
    ManagedBy = "Atlas"
{{- for tag in tags }}
